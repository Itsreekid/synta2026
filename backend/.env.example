# =====================================================
# SYNTA ACADEMY - ENVIRONMENT VARIABLES
# =====================================================
# Copy this file to .env and fill in your actual values
# NEVER commit .env to git!

# =====================================================
# SERVER CONFIG
# =====================================================
PORT=3000
NODE_ENV=development

# =====================================================
# SUPABASE CONFIG
# Get these from: https://app.supabase.com/project/_/settings/api
# =====================================================
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_KEY=your-service-role-key-here

# =====================================================
# CLOUDFLARE R2 CONFIG
# Get these from: Cloudflare Dashboard → R2 → Manage R2 API Tokens
# =====================================================
CLOUDFLARE_ACCOUNT_ID=your-account-id
R2_ACCESS_KEY=your-access-key-here
R2_SECRET_KEY=your-secret-key-here
R2_BUCKET=synta-content
R2_PUBLIC_DOMAIN=your-custom-domain.com  # Optional: for public assets

# =====================================================
# SECURITY
# =====================================================
JWT_SECRET=your-super-secret-jwt-key-change-this
ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# =====================================================
# SIGNED URL CONFIG
# =====================================================
SIGNED_URL_EXPIRY=300  # 5 minutes in seconds

# =====================================================
# PAYMENT CONFIG (Add later when integrating payment)
# =====================================================
# STRIPE_SECRET_KEY=sk_test_xxx
# PAYMENT_WEBHOOK_SECRET=whsec_xxx
