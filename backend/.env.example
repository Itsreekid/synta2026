# =====================================================
PORT=3000
NODE_ENV=development

# =====================================================
# SUPABASE CONFIG
# Get these from: https://app.supabase.com/project/_/settings/api
# =====================================================
SUPABASE_URL=https://example-project-abc123.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.example-anon-key-replace-with-real
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.example-service-key-KEEP-THIS-SECRET

# =====================================================
# CLOUDFLARE R2 CONFIG
# =====================================================
CLOUDFLARE_ACCOUNT_ID=abc123def456example789
R2_ACCESS_KEY=1a2b3c4d5e6f7g8h9i0j
R2_SECRET_KEY=example1234567890abcdefghijklmnopqrstuvwxyz1234567890
R2_BUCKET=your-bucket-name-here
R2_PUBLIC_DOMAIN=cdn.yourdomain.com  # Optional: for public assets

# =====================================================
# SECURITY
# =====================================================
JWT_SECRET=change-this-to-a-long-random-string-at-least-32-characters-long
ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,https://yourdomain.com

# =====================================================
# ZOOM SERVER-TO-SERVER OAUTH
# 1. Go to https://marketplace.zoom.us/
# 2. Create a new app → choose "Server-to-Server OAuth"
# 3. Add required scopes: meeting:write:admin
# Granular apps: rescheduling also needs meeting:update:meeting:admin (creating meetings alone is insufficient).
# 4. Copy Account ID, Client ID, Client Secret below
# =====================================================
ZOOM_ACCOUNT_ID=your_zoom_account_id_here
ZOOM_CLIENT_ID=your_zoom_client_id_here
ZOOM_CLIENT_SECRET=your_zoom_client_secret_here
# Automatic Zoom → R2 replay import (requires 202611200003, 202611240001, 202611240002).
# App scope: cloud_recording:read:list_recording_files:admin (or recording:read:admin).
# On-demand recovery also requires meeting:read:list_past_instances:admin (or meeting:read:admin).
# Event subscription: recording.completed → https://<domain>/api/zoom/webhook
# Keep disabled for deployment verification; this flag does not disable startup migrations.
ZOOM_WEBHOOK_SECRET_TOKEN=your_zoom_webhook_secret_token_here
ZOOM_RECORDING_IMPORT_ENABLED=false

# =====================================================
# SIGNED URL CONFIG
# =====================================================
SIGNED_URL_EXPIRY=300  # 5 minutes in seconds

# =====================================================
# PAYMENT CONFIG (Add later when integrating payment)
# =====================================================
# STRIPE_SECRET_KEY=sk_test_51AbCdEfGhIjKlMnOpQrStUvWxYz
# PAYMENT_WEBHOOK_SECRET=whsec_example1234567890abcdefghijklmno

# =====================================================
# GOOGLE OAUTH
# Get from: https://console.cloud.google.com → APIs & Services → Credentials
# Create an "OAuth 2.0 Client ID" of type "Web application".
# Add your deployed domain to the "Authorized JavaScript origins".
# Add https://YOUR-DOMAIN/api/auth/google/callback to "Authorized redirect URIs" for iPhone/iPad.
# =====================================================
GOOGLE_CLIENT_ID=your_google_oauth_client_id_here.apps.googleusercontent.com
# Exact number of trusted reverse-proxy hops. Coolify (Traefik) = 1; add 1 more if Cloudflare
# proxies in front of it. Set 0 for direct access. When unset: 1 in production, 0 otherwise.
TRUST_PROXY_HOPS=1

# Student deposit requests: maximum DT per request and maximum pending requests per student.
DEPOSIT_MAX_AMOUNT=1500
DEPOSIT_MAX_PENDING=5

# Bugi daily questions (Africa/Tunis day). "BUGI" applies to students holding a valid offer
# with « Inclure le tutorat Bugi » enabled; everyone else gets the FREE limit.
BUGI_DAILY_LIMIT_FREE=3
BUGI_DAILY_LIMIT_BUGI=15
# Shared Gemini budget for the whole platform (keep below the Gemini free-tier quotas).
# Free students may use only BUGI_FREE_SHARE_PERCENT of each limit; the rest is kept for Bugi offers.
BUGI_GLOBAL_DAILY_LIMIT=200
BUGI_GLOBAL_PER_MINUTE=8
BUGI_FREE_SHARE_PERCENT=20

# Optional on-demand Learning Intelligence service (separate Gemini project).
LEARNING_GEMINI_API_KEY=
LEARNING_GEMINI_ENABLED=true

# Keep timed offer purchases and reminders off until explicitly approved.
TIMED_OFFER_SALES_ENABLED=false
TIMED_OFFER_REMINDERS_ENABLED=false

TIMED_OFFER_UPGRADES_ENABLED=false
## New session creation with OR audiences; reads remain active after migration.
LIVE_MULTI_AUDIENCE_ENABLED=false
