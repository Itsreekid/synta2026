# =====================================================
PORT=3000
NODE_ENV=development

# =====================================================
# SUPABASE CONFIG
# Get these from: https://app.supabase.com/project/_/settings/api
# =====================================================
SUPABASE_URL=https://example-project-abc123.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.example-anon-key-replace-with-real
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.example-service-key-KEEP-THIS-SECRET

# =====================================================
# CLOUDFLARE R2 CONFIG
# =====================================================
CLOUDFLARE_ACCOUNT_ID=abc123def456example789
R2_ACCESS_KEY=1a2b3c4d5e6f7g8h9i0j
R2_SECRET_KEY=example1234567890abcdefghijklmnopqrstuvwxyz1234567890
R2_BUCKET=your-bucket-name-here
R2_PUBLIC_DOMAIN=cdn.yourdomain.com  # Optional: for public assets

# =====================================================
# SECURITY
# =====================================================
JWT_SECRET=change-this-to-a-long-random-string-at-least-32-characters-long
ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,https://yourdomain.com

# =====================================================
# ZOOM SERVER-TO-SERVER OAUTH
# 1. Go to https://marketplace.zoom.us/
# 2. Create a new app → choose "Server-to-Server OAuth"
# 3. Add required scopes: meeting:write:admin
# 4. Copy Account ID, Client ID, Client Secret below
# =====================================================
ZOOM_ACCOUNT_ID=your_zoom_account_id_here
ZOOM_CLIENT_ID=your_zoom_client_id_here
ZOOM_CLIENT_SECRET=your_zoom_client_secret_here

# =====================================================
# SIGNED URL CONFIG
# =====================================================
SIGNED_URL_EXPIRY=300  # 5 minutes in seconds

# =====================================================
# PAYMENT CONFIG (Add later when integrating payment)
# =====================================================
# STRIPE_SECRET_KEY=sk_test_51AbCdEfGhIjKlMnOpQrStUvWxYz
# PAYMENT_WEBHOOK_SECRET=whsec_example1234567890abcdefghijklmno

# =====================================================
# GOOGLE OAUTH
# Get from: https://console.cloud.google.com → APIs & Services → Credentials
# Create an "OAuth 2.0 Client ID" of type "Web application".
# Add your deployed domain to the "Authorized JavaScript origins".
# =====================================================
GOOGLE_CLIENT_ID=your_google_oauth_client_id_here.apps.googleusercontent.com
