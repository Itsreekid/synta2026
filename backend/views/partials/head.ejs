<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title><%= title %> - Synta Academy</title>
<!-- Turbo SPA -->
<script src="https://cdn.jsdelivr.net/npm/@hotwired/turbo@8.0.5/dist/turbo.es2017-umd.js"></script>
<!-- Turbo: configure progress bar + prefetch for instant-feel navigation -->
<script>
  // Show progress bar after 100ms (not immediately — avoids flash on fast connections)
  Turbo.setProgressBarDelay(100);
</script>
<!-- Supabase -->
<script src="https://unpkg.com/@supabase/supabase-js@2" defer></script>
<!-- Fonts -->
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Tajawal:wght@400;500;700&display=swap" rel="stylesheet" data-turbo-track="reload">
<!-- Font Awesome -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" data-turbo-track="reload">
<!-- Favicon -->
<link rel="icon" href="/source/logoweb.png" type="image/x-icon">
<!-- App Shell CSS -->
<link rel="stylesheet" href="/css/user.css" data-turbo-track="reload">
<!-- Per-page CSS (loaded when a css variable is passed from the view) -->
<% if (typeof css !== 'undefined' && css) { %>
<link rel="stylesheet" href="/css/<%= css %>.css" data-turbo-track="reload">
<% } %>
<!-- Extra head content -->
<%- (typeof extraHead !== 'undefined' && extraHead) ? extraHead : '' %>

<!-- =====================================================
     SERVER-INJECTED CONFIGURATION
     Provides Supabase credentials and the server-resolved
     user profile to the client without any async round-trip.
     This eliminates the client-side auth race condition.
     ===================================================== -->
<script id="__SYNTA_CONFIG__">
  window.__SYNTA_CONFIG__ = {
    supabaseUrl:     "<%- (typeof syntaConfig !== 'undefined' && syntaConfig.url)     ? syntaConfig.url     : '' %>",
    supabaseAnonKey: "<%- (typeof syntaConfig !== 'undefined' && syntaConfig.anonKey) ? syntaConfig.anonKey : '' %>"
  };
  <% if (typeof profile !== 'undefined' && profile) { %>
  // Pre-hydrate the global app state with the server-resolved profile.
  // Client scripts can read this immediately — no async fetch needed.
  window.__SYNTA_PROFILE__ = {
    id:          "<%- profile.id %>",
    email:       "<%- profile.email %>",
    full_name:   "<%- profile.full_name %>",
    firstName:   "<%- profile.firstName %>",
    initial:     "<%- profile.initial %>",
    phone:       "<%- profile.phone %>",
    user_class:  "<%- profile.user_class %>",
    user_branch: "<%- profile.user_branch %>",
    balance:     "<%- profile.balance %>"
  };
  <% } else { %>
  window.__SYNTA_PROFILE__ = null;
  <% } %>
</script>

<!-- Global Hydration Blocker -->
<style id="global-hydration-style">
    /* Slim Turbo progress bar */
    .turbo-progress-bar {
        height: 3px;
        background: linear-gradient(90deg, #ff7b1a, #ffa500);
        box-shadow: 0 0 8px rgba(255,123,26,0.6);
        z-index: 99999;
    }

    /*
     * Content wrapper: visible by default (server already verified auth).
     * On Turbo navigation turbo:before-render removes .hydrated briefly,
     * then authentication.js re-adds it for a clean 150ms fade-in.
     */
    .content-wrapper {
        opacity: 1;
        transition: opacity 0.15s ease;
    }
    .content-wrapper.turbo-transitioning {
        opacity: 0;
    }

    #global-hydration-overlay { display: none; }
    @keyframes spin { 100% { transform: rotate(360deg); } }
</style>
