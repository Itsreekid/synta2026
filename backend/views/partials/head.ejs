<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title><%= title %> - Synta Academy</title>
<% if (typeof turboReload !== 'undefined' && turboReload) { %>
<%# Page scripts declare top-level let/const and start on DOMContentLoaded, so a Turbo re-render would re-run them and throw. %>
<meta name="turbo-visit-control" content="reload">
<% } %>
<!-- Turbo SPA -->
<script src="https://cdn.jsdelivr.net/npm/@hotwired/turbo@8.0.5/dist/turbo.es2017-umd.js"></script>
<!-- Turbo: configure progress bar + prefetch for instant-feel navigation -->
<script>
  // Show progress bar after 100ms (not immediately — avoids flash on fast connections)
  Turbo.setProgressBarDelay(100);

  // ── Direction reset fix ──────────────────────────────────────────────────────
  // Turbo replaces <body> but NOT <html> attributes, so if one page sets
  // dir="rtl" it sticks to every subsequent page. We force ltr on every visit.
  document.addEventListener('turbo:render', function () {
    const html = document.documentElement;
    html.setAttribute('dir', 'ltr');
    html.setAttribute('lang', 'fr');
  });
</script>
<!-- Fonts -->
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Tajawal:wght@400;500;700&display=swap" rel="stylesheet" data-turbo-track="reload">
<!-- Font Awesome -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" data-turbo-track="reload">
<!-- Favicon -->
<link rel="icon" href="/source/favicon-64.png" type="image/png" sizes="64x64">
<!-- App Shell CSS -->
<link rel="stylesheet" href="/css/user.css?v=20261125-live" data-turbo-track="reload">
<link rel="stylesheet" href="/css/popups.css?v=20261125-emphasis" data-turbo-track="reload">
<% if (typeof embed === 'undefined' || !embed) { %>
<%# Embedded tools (Code Pratique inside a lesson) must not show live-session popups a second time. %>
<script defer src="/js/live-session-popup.js?v=20261126-shared"></script>
<% } %>
<!-- Per-page CSS (loaded when a css variable is passed from the view) -->
<% if (typeof css !== 'undefined' && css) { %>
<link rel="stylesheet" href="/css/<%= css %>.css<%= css === 'calendar' ? '?v=20261125-premium' : css === 'course-details' ? '?v=20261127-pdfreader2' : '' %>" data-turbo-track="reload">
<% } %>
<!-- Extra head content -->
<%- (typeof extraHead !== 'undefined' && extraHead) ? extraHead : '' %>

<!-- =====================================================
     SERVER-INJECTED USER PROFILE
     Pre-hydrates the global app state so client scripts
     can read the profile immediately — no async fetch.
     ===================================================== -->
<script id="__SYNTA_CONFIG__">
  <% if (typeof profile !== 'undefined' && profile) { %>
  <%
    const profileFields = ['id', 'email', 'full_name', 'firstName', 'initial', 'phone', 'user_class', 'user_branch', 'balance'];
    const clientProfile = Object.fromEntries(profileFields.map(key => [key, String(profile[key] ?? '')]));
  %>
  window.__SYNTA_PROFILE__ = <%- JSON.stringify(clientProfile).replace(/</g, '\\u003c').replace(/\u2028/g, '\\u2028').replace(/\u2029/g, '\\u2029') %>;
  <% } else { %>
  window.__SYNTA_PROFILE__ = null;
  <% } %>
</script>
<%# Renewable sessions refresh on the next request, so only non-renewable ones get an expiry countdown. %>
<% if (typeof user !== 'undefined' && user && Number.isFinite(user.exp) && !(typeof sessionRenewable !== 'undefined' && sessionRenewable)) { %>
<meta name="synta-session-expires-in" content="<%= Math.max(0, user.exp - Math.floor(Date.now() / 1000)) %>">
<% } %>
<% if (typeof profile !== 'undefined' && profile && profile.id) { %>
<script src="/js/session-guard.js?v=3"></script>
<% } %>

<!-- Global Hydration Blocker -->
<style id="global-hydration-style">
    /* Slim Turbo progress bar */
    .turbo-progress-bar {
        height: 3px;
        background: linear-gradient(90deg, #ff7b1a, #ffa500);
        box-shadow: 0 0 8px rgba(255,123,26,0.6);
        z-index: 99999;
    }

    /*
     * Content wrapper: visible by default (server already verified auth).
     * On Turbo navigation turbo:before-render removes .hydrated briefly,
     * then authentication.js re-adds it for a clean 150ms fade-in.
     */
    .content-wrapper {
        opacity: 1;
        transition: opacity 0.15s ease;
    }
    .content-wrapper.turbo-transitioning {
        opacity: 0;
    }

    #global-hydration-overlay { display: none; }
    @keyframes spin { 100% { transform: rotate(360deg); } }
</style>

<!-- Fallback: Ensure users are not trapped on a loading spinner -->
<noscript>
    <style>#global-hydration-overlay { display: none !important; }</style>
</noscript>
<script>
    // Fail-safe to remove the overlay after 5 seconds if initialization hangs
    setTimeout(function() {
        var overlay = document.getElementById('global-hydration-overlay');
        if (overlay) {
            overlay.style.display = 'none';
        }
    }, 5000);
</script>
