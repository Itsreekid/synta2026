<!-- Header Top Bar -->
<!-- data-* attributes are pre-populated server-side so client scripts
     can read user data instantly without any async fetch. -->
<div id="app-header-top"
     data-turbo-permanent
     class="header-top"
     data-user-name="<%= (typeof profile !== 'undefined' && profile) ? profile.full_name : '' %>"
     data-user-balance="<%= (typeof profile !== 'undefined' && profile) ? profile.balance : '0.00' %>">

    <!-- Mobile Menu Button -->
    <button type="button" class="mobile-menu-toggle" onclick="toggleMobileMenu()" aria-label="Ouvrir le menu" aria-controls="app-sidebar" aria-expanded="false">
        <span></span>
        <span></span>
        <span></span>
    </button>

    <!-- Currency Balance -->
    <div class="currency-balance">
        <img src="/source/dt.png" alt="DT" class="currency-icon">
        <span class="balance-amount" id="userBalance">
            <%= (typeof profile !== 'undefined' && profile) ? profile.balance : '0.00' %>
        </span>
    </div>

    <!-- Notification Icon -->
    <button type="button" class="notification-icon" onclick="toggleNotifications()" aria-label="Notifications" aria-haspopup="true" aria-controls="notificationDropdown" aria-expanded="false">
        <i class="fas fa-bell" aria-hidden="true"></i>
        <span class="notification-badge" id="notificationCount" style="display:none">0</span>
    </button>

    <!-- Notification Dropdown -->
    <div class="dropdown-menu" id="notificationDropdown">
        <div class="dropdown-header">Notifications</div>
        <div id="notificationEventsList">
            <!-- Events loaded by user.js via /api/events -->
        </div>
    </div>

    <!-- Profile Dropdown -->
    <div class="profile-dropdown">
        <button type="button" class="profile-picture" onclick="toggleProfileDropdown()" aria-label="Mon compte" aria-haspopup="true" aria-controls="profileDropdown" aria-expanded="false">
            <i class="fas fa-user" aria-hidden="true"></i>
        </button>
        <div class="dropdown-menu" id="profileDropdown">
            <a class="dropdown-item" href="/app/profile">
                <i class="fas fa-user" aria-hidden="true"></i>
                <span>Mon Profil</span>
            </a>
            <button type="button" class="dropdown-item" onclick="logout()">
                <i class="fas fa-sign-out-alt" aria-hidden="true"></i>
                <span>Déconnexion</span>
            </button>
        </div>
    </div>
</div>
<!-- Mobile sidebar overlay (closes sidebar when tapped) -->
<div class="sidebar-overlay" id="sidebar-overlay" onclick="toggleMobileMenu()"></div>
