<!DOCTYPE html>
<html lang="fr" dir="ltr">
<head>
    <%- include('../../partials/head', { title: 'لوحة التحكم', css: 'dashboard' }) %>
</head>
<body>
    <div id="global-hydration-overlay"><div class="spinner"></div></div>
    <%- include('../../partials/header') %>

    <div class="content-wrapper">
        <%- include('../../partials/sidebar', { active: 'dashboard' }) %>

        <section id="main-section" class="main-section">
            <div class="dashboard-container ltr-design" dir="ltr">

                <!-- ══ GREETING CARD ══ -->
                <div class="dash-card greeting-card" id="greeting-section">
                    <div class="greeting-content">
                        <h1 class="greeting-title">Salut <span id="user-name">...</span> ! 👋</h1>
                        <p class="greeting-subtitle">Prêt à continuer ton parcours en informatique ?<br><span>Chaque petit pas compte ! 💪</span></p>
                        <div class="level-badge-container">
                            <div class="level-icon">7</div>
                            <div class="level-info">
                                <strong>Niveau 7</strong>
                                <span>Python Explorer</span>
                            </div>
                            <div class="level-progress-wrapper">
                                <span class="level-xp">520 / 1000 XP</span>
                                <div class="progress-bar-bg"><div class="progress-bar-fill" style="width: 52%;"></div></div>
                            </div>
                        </div>
                    </div>
                    <div class="greeting-illustration">
                        👨‍💻
                    </div>
                </div>

                <!-- ══ STAT PILLS ══ -->
                <div class="dash-card stats-card" id="stats-section">
                    <div class="card-header">
                        <h3>🔥 Ta progression</h3>
                        <p>Continue comme ça !</p>
                    </div>
                    <div class="stats-grid">
                        <div class="stat-item">
                            <span class="stat-icon">📖</span>
                            <div class="stat-info">
                                <strong id="completed-courses">0</strong>
                                <span>Cours complétés</span>
                            </div>
                        </div>
                        <div class="stat-item">
                            <span class="stat-icon">🎯</span>
                            <div class="stat-info">
                                <strong id="overall-progress">0%</strong>
                                <span>Progression globale</span>
                            </div>
                        </div>
                        <div class="stat-item">
                            <span class="stat-icon">🏆</span>
                            <div class="stat-info">
                                <strong id="achievements">0</strong>
                                <span>Badges</span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- ══ CONTINUE LEARNING ══ -->
                <div class="dash-card continue-card" id="continue-section">
                    <div class="card-header">
                        <h3>🚀 Continuer ton apprentissage</h3>
                    </div>
                    <div class="continue-content">
                        <div class="course-logo">🐍</div>
                        <div class="course-details">
                            <h4>Python</h4>
                            <p>Les conditions</p>
                            <span class="chapter-badge">🔄 Chapitre 4 - Leçon 3</span>
                            <div class="course-progress-container">
                                <div class="progress-bar-bg"><div class="progress-bar-fill" style="width: 82%;"></div></div>
                                <span class="course-progress-text">82%</span>
                            </div>
                            <span class="time-left">⏱ ~ 18 min restantes</span>
                        </div>
                        <button class="btn-primary" onclick="window.location.href='/app/courses'">Continuer &rarr;</button>
                    </div>
                </div>

                <!-- ══ UPCOMING EVENTS ══ -->
                <div class="dash-card session-card" id="session-section">
                    <div class="card-header flex-between">
                        <h3>📅 Prochaine session</h3>
                        <a href="/app/calendar" class="link-view-all">Voir toutes &rarr;</a>
                    </div>
                    <div id="events-list">
                        <div class="loading-state">Chargement...</div>
                    </div>
                </div>

                <!-- ══ TON PARCOURS ══ -->
                <div class="dash-card path-card" id="path-section">
                    <div class="card-header flex-between">
                        <h3>🧭 Ton parcours</h3>
                        <span class="path-progress-text">72% complété</span>
                    </div>
                    <div class="path-stepper">
                        <div class="path-title">Algorithmique</div>
                        <div class="stepper-track">
                            <div class="stepper-line"><div class="stepper-line-fill" style="width: 50%;"></div></div>
                            <div class="step completed">
                                <div class="step-circle">✓</div>
                                <span>Bases</span>
                            </div>
                            <div class="step completed">
                                <div class="step-circle">✓</div>
                                <span>Conditions</span>
                            </div>
                            <div class="step current">
                                <div class="step-circle">📍</div>
                                <span>Boucles</span>
                            </div>
                            <div class="step">
                                <div class="step-circle"></div>
                                <span>Fonctions</span>
                            </div>
                            <div class="step">
                                <div class="step-circle"></div>
                                <span>Problèmes</span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- ══ QUICK ACTION GRID ══ -->
                <div class="dash-card quick-card" id="quick-section">
                    <div class="card-header">
                        <h3>⚡ Accès rapide</h3>
                    </div>
                    <div class="quick-grid">
                        <a href="/app/courses" class="quick-btn" data-turbo="true">
                            <div class="quick-icon bg-orange">📖</div>
                            <span>Cours</span>
                        </a>
                        <a href="/app/code-pratique" class="quick-btn" data-turbo="true">
                            <div class="quick-icon bg-dark">💻</div>
                            <span>Code</span>
                        </a>
                        <a href="/app/calendar" class="quick-btn" data-turbo="true">
                            <div class="quick-icon bg-dark">📅</div>
                            <span>Calendrier</span>
                        </a>
                        <a href="/app/paiement" class="quick-btn" data-turbo="true">
                            <div class="quick-icon bg-dark">💳</div>
                            <span>Mon solde</span>
                        </a>
                        <a href="/app/profile" class="quick-btn" data-turbo="true">
                            <div class="quick-icon bg-dark">👤</div>
                            <span>Profil</span>
                        </a>
                    </div>
                </div>

            </div>
        </section>
    </div>

    <script src="/js/authentication.js?v=2"></script>
    <script src="/js/user.js?v=2"></script>
    <script src="/js/dashboard.js?v=2"></script>
</body>
</html>
