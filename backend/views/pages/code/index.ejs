// ----------------------------------------------------------------
// MODE SWITCHING
// ----------------------------------------------------------------
function switchMode(mode) {
    currentMode = mode;

    document.getElementById('mode-python').style.display = mode === 'python' ? 'flex' : 'none';
    document.getElementById('mode-web').style.display    = mode === 'web'    ? 'flex' : 'none';

    document.getElementById('tab-python').classList.toggle('active', mode === 'python');
    document.getElementById('tab-web').classList.toggle('active', mode === 'web');
    document.getElementById('tab-python').setAttribute('aria-selected', String(mode === 'python'));
    document.getElementById('tab-web').setAttribute('aria-selected', String(mode === 'web'));
    try { localStorage.setItem(CP_DRAFT_PREFIX + 'mode', mode); } catch (_) {}
    updateMobileWorkspaceTabs(mode);

    const statusText = document.getElementById('cp-status-text');
    const subtitle   = document.getElementById('cp-subtitle');

    if (mode === 'python') {
        statusText.textContent = 'Python prêt';
        subtitle.innerHTML = 'Écrivez et exécutez du <a href="#">Python</a> directement dans votre navigateur – sans installation.';
        populateExamples('python');
        if (pyEditor) pyEditor.refresh();
    } else {
        statusText.textContent = 'HTML/CSS/JS prêt';
        subtitle.innerHTML = 'Construisez des pages web avec <a href="#">HTML</a>, <a href="#">CSS</a> et <a href="#">JavaScript</a>.';
        populateExamples('web');
        [webHtmlEditor, webCssEditor, webJsEditor].forEach(e => e && e.refresh());
        runWeb();
    }
}

// Mobile pane switching logic
function updateMobileWorkspaceTabs(mode) {
    const tabList = document.querySelector('.mobile-workspace-tabs');
    if (!tabList) return;
    tabList.dataset.mode = mode;
    tabList.querySelectorAll('.mobile-tab-btn').forEach(button => {
        button.hidden = !button.dataset.modes.split(',').includes(mode);
    });
    switchMobilePane('editor', tabList.querySelector('[data-pane="editor"]'));
}

function switchMobilePane(pane, selectedButton = null) {
    const activeMode = document.querySelector('.mode-panel.active');
    const tabList = document.querySelector('.mobile-workspace-tabs');
    if (!activeMode || !tabList) return;

    const button = selectedButton || tabList.querySelector(`[data-pane="${pane}"]`);
    if (!button || button.hidden) return;
    tabList.querySelectorAll('.mobile-tab-btn').forEach(tab => {
        const selected = tab === button;
        tab.classList.toggle('active', selected);
        tab.setAttribute('aria-selected', String(selected));
    });
    activeMode.querySelectorAll('.cp-panel[data-mobile-pane]').forEach(panel => {
        panel.classList.toggle('mobile-hidden', panel.dataset.mobilePane !== pane);
        if (window.matchMedia('(max-width: 700px)').matches) {
            panel.setAttribute('aria-hidden', String(panel.dataset.mobilePane !== pane));
        } else {
            panel.removeAttribute('aria-hidden');
        }
    });
    window.setTimeout(() => {
        if (pane === 'editor' && currentMode === 'python') pyEditor?.refresh();
        if (currentMode === 'web') [webHtmlEditor, webCssEditor, webJsEditor].forEach(editor => editor?.refresh());
    }, 30);
}

// Ensure initial mobile state hides the console
window.addEventListener('DOMContentLoaded', () => {
    if (window.innerWidth <= 768) {
        switchMobilePane('editor');
    }
});

