<!DOCTYPE html>
<html lang="fr" dir="ltr">
<head>
    <%- include('../../partials/head', { title: 'Code Pratique', css: 'dashboard' }) %>
    <!-- CodeMirror for syntax highlighting -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.17/codemirror.min.css" data-turbo-track="reload">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.17/theme/dracula.min.css" data-turbo-track="reload">
    <script src="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.17/codemirror.min.js" data-turbo-track="reload"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.17/mode/python/python.min.js" data-turbo-track="reload"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.17/mode/htmlmixed/htmlmixed.min.js" data-turbo-track="reload"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.17/mode/xml/xml.min.js" data-turbo-track="reload"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.17/mode/javascript/javascript.min.js" data-turbo-track="reload"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.17/mode/css/css.min.js" data-turbo-track="reload"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.17/addon/edit/matchbrackets.min.js" data-turbo-track="reload"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.17/addon/edit/closebrackets.min.js" data-turbo-track="reload"></script>
    <!-- Skulpt (Python in browser) -->
    <script src="https://skulpt.org/js/skulpt.min.js" data-turbo-track="reload"></script>
    <script src="https://skulpt.org/js/skulpt-stdlib.js" data-turbo-track="reload"></script>

    <style>
        /* ========== PAGE SHELL ========== */
        .cp-page {
            display: flex;
            flex-direction: column;
            height: calc(100vh - 70px);
            padding: 16px 20px;
            gap: 12px;
            background: #f4f5f7;
            box-sizing: border-box;
            overflow: hidden;
        }

        /* ========== TOP BAR ========== */
        .cp-topbar {
            display: flex;
            align-items: center;
            gap: 16px;
            flex-shrink: 0;
        }
        .cp-brand {
            display: flex;
            align-items: center;
            gap: 12px;
        }
        .cp-brand-icon {
            width: 44px;
            height: 44px;
            background: linear-gradient(135deg, #ff7b1a, #ff5500);
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-size: 18px;
            font-weight: bold;
            flex-shrink: 0;
        }
        .cp-brand-text h2 {
            font-size: 18px;
            font-weight: 700;
            color: #1a1a2e;
            margin: 0;
            font-family: 'Tajawal', sans-serif;
        }
        .cp-brand-text p {
            font-size: 12px;
            color: #666;
            margin: 0;
            font-family: 'Tajawal', sans-serif;
        }
        .cp-brand-text p a { color: #ff7b1a; text-decoration: none; }

        /* Mode Tabs */
        .cp-mode-tabs {
            display: flex;
            background: #e2e4ea;
            border-radius: 8px;
            padding: 3px;
            gap: 3px;
            margin-left: auto;
        }
        .cp-tab {
            padding: 7px 18px;
            border-radius: 6px;
            border: none;
            background: transparent;
            color: #666;
            font-weight: 600;
            font-size: 13px;
            cursor: pointer;
            transition: all 0.2s;
            font-family: 'Tajawal', sans-serif;
            display: flex;
            align-items: center;
            gap: 6px;
        }
        .cp-tab.active {
            background: white;
            color: #1a1a2e;
            box-shadow: 0 2px 6px rgba(0,0,0,0.12);
        }
        .cp-tab-dot-python { color: #3776ab; }
        .cp-tab-dot-web { color: #e44d26; }

        /* Status badge */
        .cp-status {
            display: flex;
            align-items: center;
            gap: 6px;
            border: 1.5px solid #22c55e;
            border-radius: 20px;
            padding: 5px 12px;
            font-size: 12px;
            color: #16a34a;
            font-weight: 600;
            font-family: 'Tajawal', sans-serif;
            flex-shrink: 0;
        }
        .cp-status-dot {
            width: 8px;
            height: 8px;
            background: #22c55e;
            border-radius: 50%;
            animation: pulse-dot 2s infinite;
        }
        @keyframes pulse-dot {
            0%, 100% { opacity: 1; }
            50% { opacity: 0.4; }
        }

        /* ========== TOOLBAR ========== */
        .cp-toolbar {
            display: flex;
            align-items: center;
            gap: 10px;
            flex-shrink: 0;
        }
        .cp-select {
            padding: 10px 16px;
            border: 1px solid #e2e8f0;
            border-radius: 8px;
            background: #f8fafc;
            color: #1e293b;
            font-size: 14px;
            cursor: pointer;
            font-family: 'Tajawal', sans-serif;
            font-weight: 500;
            outline: none;
            transition: all 0.2s;
        }
        .cp-select:focus {
            border-color: #ff7b1a;
            box-shadow: 0 0 0 3px rgba(255,123,26,0.15);
        }
        .cp-btn-toolbar {
            display: flex;
            align-items: center;
            gap: 6px;
            padding: 7px 14px;
            border-radius: 8px;
            border: 1.5px solid #ddd;
            background: white;
            color: #444;
            font-size: 13px;
            cursor: pointer;
            font-family: 'Tajawal', sans-serif;
            font-weight: 500;
            transition: all 0.2s;
        }
        .cp-btn-toolbar:hover { background: #f0f0f0; border-color: #aaa; }

        /* ========== WORKSPACE ========== */
        .cp-workspace {
            display: flex;
            gap: 14px;
            flex: 1;
            min-height: 0;
        }

        /* Panels */
        .cp-panel {
            flex: 1;
            display: flex;
            flex-direction: column;
            border-radius: 12px;
            overflow: hidden;
            background: #1e2030;
            box-shadow: 0 4px 20px rgba(0,0,0,0.2);
            min-width: 0;
        }
        .cp-panel-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 10px 16px;
            background: #252840;
            border-bottom: 1px solid #333550;
            flex-shrink: 0;
        }
        .cp-panel-dots {
            display: flex;
            align-items: center;
            gap: 6px;
        }
        .cp-panel-dots span {
            width: 12px;
            height: 12px;
            border-radius: 50%;
        }
        .dot-red   { background: #ff5f57; }
        .dot-yellow{ background: #febc2e; }
        .dot-green { background: #28c840; }
        .cp-panel-filename {
            color: #c8cce8;
            font-size: 13px;
            font-family: 'Fira Code', 'Courier New', monospace;
            margin-left: 8px;
        }
        .cp-panel-badge {
            background: #e97316;
            color: white;
            font-size: 11px;
            font-weight: 700;
            padding: 2px 8px;
            border-radius: 4px;
            font-family: monospace;
        }
        .cp-panel-badge-html {
            background: #2563eb;
            color: white;
            font-size: 11px;
            font-weight: 700;
            padding: 2px 8px;
            border-radius: 4px;
            font-family: monospace;
        }
        .cp-clear-btn {
            background: none;
            border: 1px solid #555;
            color: #aaa;
            font-size: 12px;
            padding: 3px 10px;
            border-radius: 4px;
            cursor: pointer;
            font-family: 'Tajawal', sans-serif;
            transition: all 0.2s;
        }
        .cp-clear-btn:hover { color: white; border-color: #888; }

        /* CodeMirror override */
        .cp-editor-body {
            flex: 1;
            overflow: hidden;
            display: flex;
            flex-direction: column;
            min-height: 0;
        }
        .cp-editor-body .CodeMirror {
            flex: 1;
            height: 100%;
            background: #1e2030;
            color: #abb2bf;
            font-family: 'Fira Code', 'Courier New', monospace;
            font-size: 14px;
            line-height: 1.7;
        }
        .cp-editor-body .CodeMirror-scroll {
            height: 100%;
        }
        .cp-editor-body .CodeMirror-gutters {
            background: #252840;
            border-right: 1px solid #333550;
        }
        .cp-editor-body .CodeMirror-linenumber {
            color: #4a4f6a;
        }
        .cp-editor-body .CodeMirror-cursor {
            border-left: 2px solid #ff7b1a;
        }

        /* Hint/Autocomplete bubble */
        .cp-hint {
            display: none;
            background: #2d3250;
            border: 1px solid #ff7b1a;
            border-radius: 8px;
            padding: 8px 12px;
            margin: 4px 16px;
            color: #c8cce8;
            font-size: 13px;
            font-family: 'Tajawal', sans-serif;
            flex-shrink: 0;
            white-space: pre-wrap;
        }
        .cp-hint.show { display: block; }
        .cp-hint strong { color: #f97316; }

        /* AI Debugger RTL styles */
        .cp-hint.ai-rtl {
            direction: rtl;
            text-align: right;
            background: rgba(168, 85, 247, 0.1);
            border: 1px solid #a855f7;
            color: #d8b4fe;
            line-height: 1.6;
            font-size: 15px;
        }

        /* ========================================================
           AI FLOATING DRAWER WIDGET
           ======================================================== */
        .ai-fab {
            position: fixed;
            bottom: 24px;
            right: 24px;
            z-index: 50;
            background: linear-gradient(135deg, #f97316, #f59e0b);
            color: white;
            border: none;
            border-radius: 50px;
            padding: 14px 20px;
            box-shadow: 0 10px 25px rgba(249, 115, 22, 0.4);
            cursor: pointer;
            display: flex;
            align-items: center;
            gap: 8px;
            font-family: 'Tajawal', sans-serif;
            font-weight: bold;
            font-size: 16px;
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        }
        .ai-fab:hover {
            transform: translateY(-4px) scale(1.05);
            box-shadow: 0 15px 30px rgba(249, 115, 22, 0.5);
        }

        .ai-drawer {
            position: fixed;
            bottom: 90px;
            right: 24px;
            z-index: 50;
            width: 380px;
            max-width: calc(100vw - 48px);
            height: 500px;
            max-height: calc(100vh - 120px);
            background: #1e2030;
            border: 1px solid #333550;
            border-radius: 16px;
            box-shadow: 0 15px 40px rgba(0,0,0,0.5);
            display: flex;
            flex-direction: column;
            transform: translateY(20px);
            opacity: 0;
            pointer-events: none;
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            overflow: hidden;
            font-family: 'Tajawal', sans-serif;
        }
        .ai-drawer.open {
            transform: translateY(0);
            opacity: 1;
            pointer-events: auto;
        }

        .ai-drawer-header {
            background: #252840;
            padding: 16px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-bottom: 1px solid #333550;
            color: white;
            font-size: 16px;
            direction: rtl;
        }
        .ai-drawer-header strong { font-weight: 700; }
        .ai-close-btn {
            background: transparent;
            border: none;
            color: #64748b;
            font-size: 20px;
            cursor: pointer;
            transition: color 0.2s;
        }
        .ai-close-btn:hover { color: #f87171; }

        .ai-avatar {
            width: 36px;
            height: 36px;
            background: linear-gradient(135deg, #a855f7, #8b5cf6);
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 18px;
        }

        .ai-chat-history {
            flex: 1;
            padding: 16px;
            overflow-y: auto;
            display: flex;
            flex-direction: column;
            gap: 16px;
        }

        .ai-bubble {
            max-width: 85%;
            padding: 12px 16px;
            border-radius: 12px;
            line-height: 1.6;
            font-size: 15px;
            word-wrap: break-word;
        }
        .ai-bubble.user {
            align-self: flex-start;
            background: #2d3250;
            color: #c8cce8;
            border-bottom-left-radius: 4px;
            direction: ltr; /* User code is LTR */
            font-family: 'Fira Code', monospace;
            font-size: 13px;
        }
        .ai-bubble.ai {
            align-self: flex-end;
            background: rgba(168, 85, 247, 0.15);
            border: 1px solid rgba(168, 85, 247, 0.3);
            color: #e9d5ff;
            border-bottom-right-radius: 4px;
            direction: rtl;
            text-align: right;
        }
        .ai-bubble.ai strong { color: #f97316; }

        /* Typing skeleton */
        .ai-typing {
            display: flex;
            align-items: center;
            gap: 6px;
            padding: 14px 16px;
        }
        .ai-typing span {
            width: 8px;
            height: 8px;
            background: #a855f7;
            border-radius: 50%;
            animation: bounce 1.4s infinite ease-in-out both;
        }
        .ai-typing span:nth-child(1) { animation-delay: -0.32s; }
        .ai-typing span:nth-child(2) { animation-delay: -0.16s; }
        @keyframes bounce {
            0%, 80%, 100% { transform: scale(0); }
            40% { transform: scale(1); }
        }


        /* Editor footer */
        .cp-editor-footer {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 10px 16px;
            background: #252840;
            border-top: 1px solid #333550;
            flex-shrink: 0;
        }
        .cp-run-btn {
            display: flex;
            align-items: center;
            gap: 8px;
            background: linear-gradient(135deg, #ff7b1a, #ff5500);
            color: white;
            border: none;
            padding: 10px 22px;
            border-radius: 8px;
            font-size: 14px;
            font-weight: 700;
            cursor: pointer;
            font-family: 'Tajawal', sans-serif;
            transition: all 0.2s;
            box-shadow: 0 2px 12px rgba(255, 123, 26, 0.4);
        }
        .cp-run-btn:hover {
            transform: translateY(-1px);
            box-shadow: 0 4px 18px rgba(255, 123, 26, 0.6);
        }
        .cp-run-btn:active { transform: translateY(0); }
        .cp-shortcut {
            color: #556;
            font-size: 12px;
            font-family: 'Tajawal', sans-serif;
        }

        /* Console / Output panel */
        .cp-console {
            flex: 1;
            display: flex;
            flex-direction: column;
            min-height: 0;
            overflow-y: auto;
            padding: 16px;
            font-family: 'Fira Code', 'Courier New', monospace;
            font-size: 16px;
            line-height: 1.6;
            background: #1e2030;
            scrollbar-width: thin;
            scrollbar-color: #444 #1e2030;
        }
        .cp-console::-webkit-scrollbar { width: 5px; }
        .cp-console::-webkit-scrollbar-track { background: #1e2030; }
        .cp-console::-webkit-scrollbar-thumb { background: #444; border-radius: 3px; }
        .console-ready   { color: #22c55e; font-weight: bold; }
        .console-comment { color: #555e8a; }
        .console-output  { color: #c8cce8; white-space: pre-wrap; }
        .console-error   { color: #f87171; white-space: pre-wrap; }
        .console-hint    { color: #fbbf24; white-space: pre-wrap; }
        .console-input-prompt { color: #818cf8; }

        /* HTML preview panel */
        .cp-preview {
            flex: 1;
            border: none;
            background: white;
            display: block;
        }

        /* ========== MODE PANELS ========== */
        .mode-panel { display: none; flex-direction: row; height: 100%; }
        .mode-panel.active { display: flex; }

        /* ========== WEB EDITOR - 3 pane ========== */
        .web-editor-area {
            display: flex;
            flex-direction: column;
            flex: 1;
            min-height: 0;
        }
        .web-editor-tabs {
            display: flex;
            background: #252840;
            border-bottom: 1px solid #333550;
            flex-shrink: 0;
        }
        .web-editor-tab {
            padding: 8px 18px;
            border: none;
            background: transparent;
            color: #667;
            font-size: 13px;
            font-family: 'Fira Code', monospace;
            cursor: pointer;
            border-bottom: 2px solid transparent;
            transition: all 0.2s;
        }
        .web-editor-tab.active {
            color: #c8cce8;
            border-bottom-color: #ff7b1a;
        }
        .web-pane { display: none; flex: 1; min-height: 0; }
        .web-pane.active { display: flex; flex-direction: column; }
        .web-pane .CodeMirror {
            flex: 1;
            height: 100%;
            background: #1e2030;
            color: #abb2bf;
            font-family: 'Fira Code', monospace;
            font-size: 16px;
            line-height: 1.6;
        }
        .web-pane .CodeMirror-scroll { height: 100%; }
        .web-pane .CodeMirror-gutters {
            background: #252840;
            border-right: 1px solid #333550;
        }
        .web-pane .CodeMirror-linenumber { color: #4a4f6a; }
        .web-pane .CodeMirror-cursor { border-left: 2px solid #2563eb; }

        /* ========== RESPONSIVE — mobile first ========== */
        @media (max-width: 900px) {
            .cp-workspace { flex-direction: column; }
            .cp-topbar { flex-wrap: wrap; }
        }

        @media (max-width: 768px) {
            /* Page padding */
            .cp-page {
                padding: 10px 12px;
                gap: 8px;
                height: auto;
                min-height: calc(100vh - 70px);
                overflow-y: auto;
            }

            /* Topbar: brand + status on one row, tabs below */
            .cp-topbar {
                flex-wrap: wrap;
                gap: 10px;
            }
            .cp-brand-text h2 { font-size: 15px; }
            .cp-brand-text p  { font-size: 11px; }
            .cp-brand-icon    { width: 36px; height: 36px; font-size: 14px; }
            .cp-status        { font-size: 11px; padding: 4px 10px; }
            .cp-mode-tabs     { order: 3; width: 100%; justify-content: center; }
            .cp-tab           { flex: 1; justify-content: center; font-size: 12px; padding: 7px 8px; }

            /* Toolbar */
            .cp-toolbar { gap: 6px; }
            .cp-select  { font-size: 12px; padding: 6px 8px; flex: 1; }
            .cp-btn-toolbar { font-size: 12px; padding: 6px 10px; }

            /* Workspace — stacked, each panel is tall enough to be usable */
            .cp-workspace { flex-direction: column; gap: 10px; }
            #mode-python  { flex-direction: column !important; gap: 10px; }
            #mode-web     { flex-direction: column !important; gap: 10px; }

            .mobile-workspace-tabs { display: flex !important; }
            .cp-panel.mobile-hidden { display: none !important; }

            /* Each panel: fixed height so code is visible + scrollable */
            .cp-panel { min-height: calc(100vh - 240px) !important; max-height: none !important; }

            /* Editor body fills panel */
            .cp-editor-body { flex: 1; min-height: 0; }
            .cp-editor-body .CodeMirror { font-size: 13px; line-height: 1.6; }

            /* Web editor tabs compact */
            .web-editor-tab { padding: 7px 12px; font-size: 12px; }
            .web-pane .CodeMirror { font-size: 13px; }

            /* Console */
            .cp-console { font-size: 12.5px; padding: 12px; }

            /* Preview iframe tall enough to see result */
            .cp-preview { min-height: 220px; }

            /* Run button full width on mobile */
            .cp-editor-footer { flex-wrap: wrap; gap: 8px; }
            .cp-run-btn { flex: 1; justify-content: center; font-size: 13px; padding: 10px 16px; }
            .cp-shortcut { font-size: 11px; }

            /* Hint box */
            .cp-hint { font-size: 12px; margin: 4px 10px; }

            /* Input modal */
            .input-modal { min-width: unset; padding: 20px 18px; }
            .input-modal-prompt { font-size: 13px; }
            .input-modal-field  { font-size: 13px; }
        }

        @media (max-width: 420px) {
            .cp-panel { min-height: 240px; max-height: 320px; }
            .cp-brand-icon { display: none; }
        }

        /* ========== FIX CodeMirror blank space ========== */
        /* Dracula theme adds padding-top:4px to .CodeMirror-lines — zero it out */
        .cp-editor-body .CodeMirror,
        .web-pane .CodeMirror {
            font-size: 16px;
            line-height: 1.6;
        }
        .cp-editor-body .CodeMirror-lines,
        .web-pane .CodeMirror-lines {
            padding-top: 0 !important;
        }
        /* Make all hidden web panes show as flex so CodeMirror measures correctly */
        .web-pane {
            position: absolute;
            visibility: hidden;
            pointer-events: none;
            top: 0; left: 0; right: 0; bottom: 0;
            min-height: 0;
        }
        .web-pane.active {
            position: relative;
            visibility: visible;
            pointer-events: all;
            display: flex;
            flex-direction: column;
        }
        /* ========== INPUT MODAL ========== */
        .input-modal-overlay {
            position: fixed;
            inset: 0;
            background: rgba(10, 10, 20, 0.75);
            backdrop-filter: blur(6px);
            -webkit-backdrop-filter: blur(6px);
            z-index: 99999;
            display: flex;
            align-items: center;
            justify-content: center;
            opacity: 0;
            pointer-events: none;
            transition: opacity 0.2s ease;
        }
        .input-modal-overlay.show {
            opacity: 1;
            pointer-events: all;
        }
        .input-modal {
            background: #252840;
            border: 1px solid #3d4166;
            border-radius: 16px;
            padding: 28px 32px;
            min-width: 360px;
            max-width: 480px;
            width: 90%;
            box-shadow: 0 24px 60px rgba(0,0,0,0.5);
            transform: translateY(12px) scale(0.97);
            transition: transform 0.22s ease, opacity 0.2s ease;
        }
        .input-modal-overlay.show .input-modal {
            transform: translateY(0) scale(1);
        }
        .input-modal-header {
            display: flex;
            align-items: center;
            gap: 10px;
            margin-bottom: 16px;
        }
        .input-modal-icon {
            width: 36px;
            height: 36px;
            background: linear-gradient(135deg, #818cf8, #6366f1);
            border-radius: 8px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 16px;
            flex-shrink: 0;
        }
        .input-modal-title {
            font-size: 13px;
            font-weight: 700;
            color: #c8cce8;
            font-family: 'Tajawal', sans-serif;
            letter-spacing: 0.5px;
            text-transform: uppercase;
        }
        .input-modal-prompt {
