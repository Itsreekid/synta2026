        .cp-code-window .cp-visualizer {
            background: var(--cp-window);
            color: var(--cp-text);
            border-color: var(--cp-edge);
        }
        .cp-code-window .cp-editor-body .CodeMirror {
            font: 600 clamp(17px, 1.3vw, 20px)/1.65 var(--cp-mono);
        }
        .cp-code-window .cp-console {
            font: 400 clamp(15px, 1.05vw, 17px)/1.65 var(--cp-mono);
        }
        .cp-code-window .cp-editor-body .CodeMirror-linenumber {
            font-family: var(--cp-mono);
            font-size: 13px;
        }
        .cp-code-window .cm-s-synta .CodeMirror-matchingbracket {
            color: var(--cp-cyan);
            text-decoration: underline;
        }
        .cp-code-window .cm-s-synta .CodeMirror-nonmatchingbracket {
            color: #fecaca;
            text-decoration: underline;
        }
        .cp-code-window .CodeMirror-lines { padding: 14px 0; }
        .cp-code-window .CodeMirror pre.CodeMirror-line,
        .cp-code-window .CodeMirror pre.CodeMirror-line-like { padding-inline: 10px; }
        .cp-code-window .cm-s-synta .cm-keyword,
        .cp-code-window .cm-s-synta .cm-builtin,
        .cp-code-window .cm-s-synta .cm-def,
        .cp-code-window .console-ready,
        .cp-code-window .vis-var-name { color: var(--cp-cyan); }
        .cp-code-window .cm-s-synta .cm-operator { color: var(--cp-text); }
        .cp-code-window .cm-s-synta .cm-string,
        .cp-code-window .cm-s-synta .cm-string-2,
        .cp-code-window .cm-s-synta .cm-number,
        .cp-code-window .vis-val-number { color: #ffba7a; }
        .cp-code-window .cp-editor-body .CodeMirror-linenumber,
        .cp-code-window .cm-s-synta .cm-comment,
        .cp-code-window .console-comment,
        .cp-code-window .cp-shortcut,
        .cp-code-window .cp-visualizer-empty,
        .cp-code-window .vis-var-type { color: var(--cp-muted); }
        .cp-code-window .cm-s-synta .CodeMirror-selected { background: #24536b; }
        .cp-code-window .cp-run-btn { background: #f6851f; color: var(--cp-window); box-shadow: none; }
        .cp-code-window .cp-run-btn:hover { background: #ffa34f; }
        .cp-code-window .cp-export-btn,
        .cp-code-window .cp-ai-btn,
        .cp-code-window .cp-clear-btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            border: 1px solid var(--cp-edge);
            background: var(--cp-window);
            color: var(--cp-text);
            cursor: pointer;
        }
        .cp-code-window .cp-export-btn:hover,
        .cp-code-window .cp-ai-btn:hover,
        .cp-code-window .cp-clear-btn:hover { background: var(--cp-edge); }
        .cp-code-window button:focus-visible { outline: 2px solid var(--cp-cyan); outline-offset: 2px; }
        .cp-code-window .cp-visualizer { flex: 1; min-height: 0; overflow-y: auto; }
        .cp-code-window .cp-visualizer-empty { flex: 1; min-height: 0; margin: 0; }
        .cp-code-window .cp-visualizer-empty > span:first-child { color: var(--cp-cyan); }
        .cp-code-window .cp-visualizer-hint { display: block; margin-top: 6px; font-size: 12px; }
        .cp-code-window .vis-card { background: var(--cp-chrome); border-color: var(--cp-edge); }
        .cp-code-window .vis-val-string { color: #85e3c0; }
        .cp-code-window .vis-val-bool { color: #d7bdfb; }
        .cp-code-window .vis-val-list { color: var(--cp-cyan); }
    </style>
</head>
<body>
