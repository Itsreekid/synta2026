    document.getElementById('web-pane-' + tab).classList.add('active');

    const badges = { html: 'HTML', css: 'CSS', js: 'JavaScript' };
    const files  = { html: 'index.html', css: 'style.css', js: 'script.js' };
    document.getElementById('web-badge').textContent    = badges[tab];
    document.getElementById('web-filename').textContent = files[tab];

    const editors = { html: webHtmlEditor, css: webCssEditor, js: webJsEditor };
    if (editors[tab]) editors[tab].refresh();
}

