function exportPythonCode() {
    if (!pyEditor) return;
    const code = pyEditor.getValue();
    const blob = new Blob([code], { type: 'text/x-python;charset=utf-8' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = 'mon_code.py';
    document.body.appendChild(a);
    a.click();
    document.body.removeChild(a);
    URL.revokeObjectURL(url);
}

function showPythonResultOnMobile() {
    if (!window.matchMedia('(max-width: 700px)').matches || currentMode !== 'python') return;
    const editorTab = document.querySelector('.mobile-workspace-tabs [data-pane="editor"].active');
    if (!editorTab) return;

    const consoleTab = document.querySelector('.mobile-workspace-tabs [data-pane="console"]');
    switchMobilePane('console', consoleTab);
    consoleTab.focus();
}

let lastPythonRunCode = null;

function runPython() {
    if (!pyEditor || pythonRunInProgress) return;
    const code = pyEditor.getValue();
    const runBtn = document.getElementById('run-btn');
    if (!code.trim()) {
        clearConsole();
        appendConsole('<span class="console-comment">Écris du code, puis lance l’exécution.</span>\n');
        pyEditor.focus();
        return;
    }

    lastPythonRunCode = code;
    if (requiresSyllabusPythonRuntime(code)) {
        runPythonWithPyodide(code);
        return;
    }

    clearConsole();
    pythonRunInProgress = true;
    if (runBtn) runBtn.disabled = true;
    const originalBtnHTML = runBtn?.innerHTML || '';
    const originalBtnBg = runBtn?.style.background || '';
    const originalBtnTitle = runBtn?.title || 'Exécuter le code';
    const originalBtnLabel = runBtn?.getAttribute('aria-label') || 'Exécuter le code';
    
    if (runBtn) {
        runBtn.innerHTML = '<i class="fas fa-spinner fa-spin" aria-hidden="true"></i>';
        runBtn.title = 'Exécution en cours';
        runBtn.setAttribute('aria-label', 'Exécution en cours');
        runBtn.style.opacity = '0.8';
    }

    const statusEl = document.getElementById('cp-status-text');
    statusEl.textContent = '⏳ Exécution...';

    function outf(text) { appendConsole('<span class="console-output">' + escapeHtml(text) + '</span>'); }
    function errf(err)  {
        const msg = err.toString();
        // Add structured error output to console with a manual Bugi action button
        const bugiBtnHTML = `<button onclick="askAiDebugger()" style="margin-top:12px; padding:6px 12px; border:none; border-radius:6px; background:#a855f7; color:white; font-family:'Tajawal',sans-serif; cursor:pointer; font-size:13px; font-weight:600;"><i class="fas fa-magic"></i> 🐞 Voir l'explication de Bugi</button>`;
        
        appendConsole('\n<span class="console-error" style="display:block; padding:8px; border-left:3px solid #ef4444; background:rgba(239,68,68,0.1); border-radius:0 4px 4px 0; margin-top:8px;">❌ <strong>Erreur :</strong><br>' + escapeHtml(msg) + '<br>' + bugiBtnHTML + '</span>\n');
        
        if (runBtn) {
            runBtn.innerHTML = '<i class="fas fa-exclamation-triangle" aria-hidden="true"></i>';
            runBtn.title = 'Erreur d’exécution';
            runBtn.setAttribute('aria-label', 'Erreur d’exécution');
            runBtn.style.background = '#ef4444';
            runBtn.style.opacity = '1';
        }
        
        // Highlight Bugi button but do not interrupt the student automatically
        triggerBugiError();
        
        setTimeout(() => {
            if (runBtn) {
                runBtn.innerHTML = originalBtnHTML;
                runBtn.title = originalBtnTitle;
                runBtn.setAttribute('aria-label', originalBtnLabel);
                runBtn.style.background = originalBtnBg;
            }
        }, 2500);
    }

    Sk.configure({
        output: outf,
        // input() handler — shows beautiful modal, returns Promise
        inputfun: (prompt) => showInputModal(prompt || ''),
        inputfunTakesPrompt: true,
        read: (x) => {
            if (Sk.builtinFiles === undefined || Sk.builtinFiles["files"][x] === undefined)
                throw "Fichier introuvable : '" + x + "'";
            return Sk.builtinFiles["files"][x];
        },
        execLimit: 30000
    });

    const promise = Sk.misceval.asyncToPromise(() =>
        Sk.importMainWithBody("<stdin>", false, code, true)
    );

    promise.then(
        (module) => {
            appendConsole('\n<span class="console-comment" style="color:#10b981; font-weight:bold;">✓ Exécution réussie</span>\n');
            pythonRunInProgress = false;
            if (runBtn) runBtn.disabled = false;
            statusEl.textContent = 'Python prêt';
            
            if (runBtn) {
                runBtn.innerHTML = '<i class="fas fa-check" aria-hidden="true"></i>';
                runBtn.title = 'Exécution réussie';
                runBtn.setAttribute('aria-label', 'Exécution réussie');
                runBtn.style.background = '#10b981';
                runBtn.style.opacity = '1';
            }
            
            setTimeout(() => {
                if (runBtn) {
                    runBtn.innerHTML = originalBtnHTML;
                    runBtn.title = originalBtnTitle;
                    runBtn.setAttribute('aria-label', originalBtnLabel);
                    runBtn.style.background = originalBtnBg;
                }
            }, 2000);
            
            if(module && module.$d) {
                renderStateVisualizer(module.$d);
            }
            showPythonResultOnMobile();
        },
        (err) => {
            errf(err);
            showPythonResultOnMobile();
            pythonRunInProgress = false;
            if (runBtn) runBtn.disabled = false;
            statusEl.textContent = 'Python prêt';
        }
    );
}

function requiresSyllabusPythonRuntime(code) {
    const importsModule = /^\s*(?:from\s+[A-Za-z_]\w*(?:\.[A-Za-z_]\w*)*\s+import\b|import\s+[A-Za-z_]\w*)/m.test(code);
    const usesMatchCase = /^\s*match\s+.+:\s*(?:#.*)?$/m.test(code);
    return importsModule || usesMatchCase;
}

function ensurePyodideRunnerFrame() {
    if (pyodideRunnerFrame?.isConnected) return Promise.resolve(pyodideRunnerFrame);
    if (pyodideRunnerFramePromise) return pyodideRunnerFramePromise;

    pyodideRunnerFramePromise = new Promise((resolve, reject) => {
        const frame = document.createElement('iframe');
        frame.className = 'pyodide-runner-frame';
        frame.title = 'Moteur Python isolé';
        frame.setAttribute('sandbox', 'allow-scripts allow-modals');
        frame.setAttribute('aria-hidden', 'true');
        frame.referrerPolicy = 'no-referrer';
        frame.onload = () => {
            pyodideRunnerFrame = frame;
            resolve(frame);
        };
        frame.onerror = () => {
            frame.remove();
            pyodideRunnerFramePromise = null;
            reject(new Error('Le moteur Python complet ne peut pas être chargé. Vérifie ta connexion puis réessaie.'));
        };
        frame.src = '/pyodide-runner.html';
        document.body.appendChild(frame);
    });

    return pyodideRunnerFramePromise;
}

function appendPythonRuntimeOutput(text, className = 'console-output cp-console-output') {
    const consoleElement = document.getElementById('py-console');
    if (!consoleElement || text == null || text === '') return;
    const line = document.createElement('span');
    line.className = className;
    line.textContent = String(text);
    consoleElement.appendChild(line);
    consoleElement.scrollTop = consoleElement.scrollHeight;
}

function appendPyodideError(message) {
    const bugiBtnHTML = `<button onclick="askAiDebugger()" style="margin-top:12px; padding:6px 12px; border:none; border-radius:6px; background:#a855f7; color:white; font-family:'Tajawal',sans-serif; cursor:pointer; font-size:13px; font-weight:600;"><i class="fas fa-magic"></i> 🐞 Voir l'explication de Bugi</button>`;
    appendConsole(
        '\n<span class="console-error" style="display:block; padding:8px; border-left:3px solid #ef4444; background:rgba(239,68,68,0.1); border-radius:0 4px 4px 0; margin-top:8px;">❌ <strong>Erreur :</strong><br>' +
        escapeHtml(message || 'Erreur Python') +
        '<br>' + bugiBtnHTML + '</span>\n'
    );
    triggerBugiError();
}

function renderPyodideVariables(variables) {
    const visualizer = document.getElementById('py-visualizer');
    if (!visualizer) return;
    visualizer.replaceChildren();

    if (!Array.isArray(variables) || variables.length === 0) {
        visualizer.innerHTML = `
            <div class="cp-visualizer-empty">
                <span style="font-size: 32px; opacity: 0.8;">◇</span>
                <span>Aucune variable affichable après cette exécution.</span>
            </div>`;
        return;
    }

    variables.forEach(variable => {
        const card = document.createElement('div');
        card.className = 'vis-card';

        const info = document.createElement('div');
        info.className = 'vis-info';

        const name = document.createElement('span');
        name.className = 'vis-var-name';
        name.textContent = variable.name;

        const type = document.createElement('span');
        type.className = 'vis-var-type';
        type.textContent = String(variable.type || 'OBJET').toUpperCase();

        const value = document.createElement('div');
        value.className = 'vis-var-value';
        value.textContent = variable.value;
        value.title = variable.value;

        info.append(name, type);
        card.append(info, value);
        visualizer.appendChild(card);
    });
}

function resetPythonRunButton(runButton, original) {
    if (!runButton || !original) return;
    runButton.disabled = false;
    runButton.innerHTML = original.html;
    runButton.title = original.title;
    runButton.setAttribute('aria-label', original.label);
    runButton.style.opacity = '1';
    runButton.style.background = original.background;
}

async function runPythonWithPyodide(code) {
    const runButton = document.getElementById('run-btn');
    const statusText = document.getElementById('cp-status-text');
    const runId = ++pyodideRunSequence;
    const originalBtn = {
        html: runButton?.innerHTML || '',
        title: runButton?.title || 'Exécuter le code',
        label: runButton?.getAttribute('aria-label') || 'Exécuter le code',
        background: runButton?.style.background || ''
    };

    clearConsole();
    pythonRunInProgress = true;
    if (runButton) {
        runButton.disabled = true;
        runButton.innerHTML = '<i class="fas fa-spinner fa-spin" aria-hidden="true"></i>';
        runButton.title = pyodideRuntimeReady ? 'Exécution en cours' : 'Chargement du moteur Python';
        runButton.setAttribute('aria-label', runButton.title);
        runButton.style.opacity = '0.8';
    }
    if (statusText) {
        statusText.textContent = pyodideRuntimeReady
            ? '⏳ Exécution...'
            : 'Chargement du moteur Python compatible avec le programme scolaire…';
    }
    if (!pyodideRuntimeReady) {
        appendPythonRuntimeOutput(
            'Premier démarrage : chargement du moteur Python compatible avec NumPy et match/case…\n',
            'console-comment cp-console-output'
        );
    }

    try {
        const frame = await ensurePyodideRunnerFrame();
        const result = await new Promise((resolve, reject) => {
            const timeout = window.setTimeout(() => {
                if (activePyodideRun?.runId === runId) activePyodideRun = null;
                reject(new Error('Le moteur Python ne répond pas. Réessaie avec un programme plus court.'));
            }, 120000);
            activePyodideRun = {
                runId,
                resolve: value => { window.clearTimeout(timeout); resolve(value); },
                reject: error => { window.clearTimeout(timeout); reject(error); }
            };
            frame.contentWindow.postMessage({ channel: 'synta-pyodide', type: 'run', runId, code }, '*');
        });

        pyodideRuntimeReady = true;
        if (result.variables) renderPyodideVariables(result.variables);

        if (result.ok) {
            appendConsole('\n<span class="console-comment" style="color:#10b981; font-weight:bold;">✓ Exécution réussie</span>\n');
            if (statusText) statusText.textContent = 'Python prêt';
            if (runButton) {
                runButton.innerHTML = '<i class="fas fa-check" aria-hidden="true"></i>';
                runButton.title = 'Exécution réussie';
                runButton.setAttribute('aria-label', 'Exécution réussie');
                runButton.style.background = '#10b981';
                runButton.style.opacity = '1';
                setTimeout(() => resetPythonRunButton(runButton, originalBtn), 2000);
            }
        } else {
            appendPyodideError(result.error || 'Erreur Python');
            if (statusText) statusText.textContent = 'Python prêt';
            if (runButton) {
                runButton.innerHTML = '<i class="fas fa-exclamation-triangle" aria-hidden="true"></i>';
                runButton.title = 'Erreur d’exécution';
                runButton.setAttribute('aria-label', 'Erreur d’exécution');
                runButton.style.background = '#ef4444';
                runButton.style.opacity = '1';
                setTimeout(() => resetPythonRunButton(runButton, originalBtn), 2500);
            }
        }
    } catch (error) {
        appendPyodideError(error.message || 'Impossible de lancer ce programme.');
        if (statusText) statusText.textContent = 'Python prêt';
        if (runButton) {
            runButton.innerHTML = '<i class="fas fa-exclamation-triangle" aria-hidden="true"></i>';
            runButton.title = 'Erreur d’exécution';
            runButton.setAttribute('aria-label', 'Erreur d’exécution');
            runButton.style.background = '#ef4444';
            runButton.style.opacity = '1';
            setTimeout(() => resetPythonRunButton(runButton, originalBtn), 2500);
        }
    } finally {
        showPythonResultOnMobile();
        pythonRunInProgress = false;
        if (runButton) runButton.disabled = false;
        if (runButton && !runButton.innerHTML.includes('fa-check') && !runButton.innerHTML.includes('fa-exclamation-triangle')) {
            resetPythonRunButton(runButton, originalBtn);
        }
    }
}

window.addEventListener('message', event => {
    if (!pyodideRunnerFrame || event.source !== pyodideRunnerFrame.contentWindow) return;
    const message = event.data;
    if (!message || message.channel !== 'synta-pyodide') return;

    // iframe script loaded; Pyodide itself is still lazy until the first advanced run
    if (message.type === 'ready') return;

    if (!activePyodideRun || message.runId !== activePyodideRun.runId) return;

    if (message.type === 'output') appendPythonRuntimeOutput(message.text);
    if (message.type === 'stderr') {
        appendPythonRuntimeOutput(message.text, 'console-error cp-console-output');
    }
    if (message.type === 'complete') {
        const pending = activePyodideRun;
        activePyodideRun = null;
        pending.resolve(message);
    }
});

function renderStateVisualizer(dict) {
    const vis = document.getElementById('py-visualizer');
    if (!vis) return;
    vis.innerHTML = ''; 

    const ignored = ['__name__', '__doc__', '__package__', '__loader__', '__spec__', '__annotations__', '__builtins__', '__file__', '__cached__'];
    let count = 0;

    for (const [key, pyObj] of Object.entries(dict)) {
        if (ignored.includes(key)) continue;
        if (typeof pyObj === 'function' || !pyObj || typeof pyObj.v === 'undefined') continue; 

        count++;
        let val = pyObj.v;
        let typeStr = 'UNKNOWN';
        let valClass = '';
        let valStr = String(val);

        if (typeof val === 'number') {
            typeStr = Number.isInteger(val) ? 'ENTIER' : 'RÉEL';
            valClass = 'vis-val-number';
        } else if (typeof val === 'string') {
            typeStr = 'CHAÎNE';
            valClass = 'vis-val-string';
            valStr = `"${val}"`;
        } else if (typeof val === 'boolean') {
            typeStr = 'BOOLÉEN';
            valClass = 'vis-val-bool';
            valStr = val ? "Vrai" : "Faux";
        } else if (Array.isArray(val)) {
            typeStr = 'TABLEAU';
            valClass = 'vis-val-list';
            valStr = '[' + val.map(v => (v && typeof v.v !== 'undefined') ? v.v : String(v)).join(', ') + ']';
        } else {
            typeStr = 'OBJET';
        }

        const card = document.createElement('div');
        card.className = 'vis-card';
        card.innerHTML = `
            <div class="vis-info">
                <span class="vis-var-name">${escapeHtml(key)}</span>
                <span class="vis-var-type">${typeStr}</span>
            </div>
            <div class="vis-var-value ${valClass}" title="${escapeHtml(valStr)}">${escapeHtml(valStr)}</div>
        `;
        vis.appendChild(card);
    }

    if (count === 0) {
        vis.innerHTML = `
            <div class="cp-visualizer-empty">
                <span style="font-size: 32px; opacity: 0.8;">◇</span>
                <span>Aucune variable.<span class="cp-visualizer-hint">Exécute ton code pour voir les variables apparaître ici.</span></span>
            </div>`;
    }
}

function clearConsole() {
    document.getElementById('py-console').innerHTML = '';
    document.getElementById('py-hint').classList.remove('show');
    const vis = document.getElementById('py-visualizer');
    if (vis) {
        vis.innerHTML = `
            <div class="cp-visualizer-empty">
                <span style="font-size: 32px; opacity: 0.8;">◇</span>
                <span>Aucune variable.<span class="cp-visualizer-hint">Exécute ton code pour voir les variables apparaître ici.</span></span>
            </div>`;
    }
}

function showConsoleWelcome() {
    appendConsole('<span class="console-ready">Bienvenue dans Code Pratique</span>\n');
    appendConsole('<span class="console-comment">Modifie ton programme, puis clique sur « Exécuter le code ».</span>\n');
    appendConsole('<span class="console-comment">Le résultat et les réponses à input() apparaissent ici. Raccourci : Ctrl + Entrée.</span>\n');
}

function appendConsole(html) {
    const c = document.getElementById('py-console');
    c.innerHTML += html;
    c.scrollTop = c.scrollHeight;
}

function escapeHtml(str) {
    return String(str)
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;');
}

