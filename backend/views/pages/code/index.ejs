const CP_DRAFT_PREFIX = 'synta:code-pratique:draft:';

function readCodeDraft(name, fallback) {
    try { return localStorage.getItem(CP_DRAFT_PREFIX + name) ?? fallback; }
    catch (_) { return fallback; }
}

function saveCodeDraft(name, value) {
    try { localStorage.setItem(CP_DRAFT_PREFIX + name, value); }
    catch (error) { console.warn('Could not save the local code draft:', error.message); }
}

