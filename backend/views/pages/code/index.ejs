        { r: /NameError.*'(\w+)'/i,       fr: (m) => `Erreur de nom : '${m[1]}' n'est pas défini. Vérifiez l'orthographe ou définissez la variable.`, ar: (m) => `خطأ: '${m[1]}' غير معرّف. تحقق من الإملاء أو عرّف المتغير.` },
        { r: /SyntaxError/i,              fr: () => `Erreur de syntaxe : vérifiez les deux-points ':' après if / for / while / def, et l'indentation.`, ar: () => `خطأ في الصياغة: تحقق من النقطتين ':' بعد if/for/while/def والمسافات البادئة.` },
        { r: /IndentationError/i,         fr: () => `Erreur d'indentation : les lignes à l'intérieur d'une boucle ou condition doivent avoir 4 espaces.`, ar: () => `خطأ في المسافة البادئة: الأسطر داخل الحلقة أو الشرط يجب أن تبدأ بـ 4 مسافات.` },
        { r: /TypeError.*unsupported.*'(\w+)'/i, fr: (m) => `Erreur de type : opération non supportée. Vérifiez que vous mélangez pas texte et nombre.`, ar: () => `خطأ في النوع: تأكد أنك لا تخلط بين النص والأرقام في نفس العملية.` },
        { r: /ZeroDivisionError/i,        fr: () => `Erreur : division par zéro est interdite en mathématiques !`, ar: () => `خطأ: القسمة على صفر ممنوعة رياضياً!` },
        { r: /IndexError/i,               fr: () => `Erreur d'index : vous essayez d'accéder à un élément qui n'existe pas dans la liste.`, ar: () => `خطأ في الفهرس: تحاول الوصول لعنصر غير موجود في القائمة.` },
        { r: /KeyError.*'(\w+)'/i,        fr: (m) => `Erreur de clé : '${m[1]}' n'existe pas dans le dictionnaire.`, ar: (m) => `خطأ: المفتاح '${m[1]}' غير موجود في القاموس.` },
        { r: /ValueError/i,               fr: () => `Erreur de valeur : la valeur fournie n'est pas du bon type ou format.`, ar: () => `خطأ في القيمة: القيمة المُعطاة ليست من النوع أو الصيغة الصحيحة.` },
        { r: /RecursionError/i,           fr: () => `Erreur de récursion : votre fonction s'appelle elle-même à l'infini. Ajoutez une condition d'arrêt.`, ar: () => `خطأ في التكرار: الدالة تستدعي نفسها إلى ما لا نهاية. أضف شرط توقف.` },
        { r: /AttributeError.*'(\w+)'/i,  fr: (m) => `Erreur d'attribut : '${m[1]}' n'existe pas. Vérifiez le type de votre variable.`, ar: (m) => `خطأ في الخاصية: '${m[1]}' غير موجودة. تحقق من نوع المتغير.` },
    ];
    for (const rule of rules) {
        const m = msg.match(rule.r);
        if (m) {
            return { fr: rule.fr(m), ar: rule.ar(m) };
        }
    }
    return { fr: `Erreur Python : ${msg}`, ar: `خطأ Python: ${msg}` };
}

// ----------------------------------------------------------------
// MODE SWITCHING
// ----------------------------------------------------------------
function switchMode(mode) {
    currentMode = mode;

    document.getElementById('mode-python').style.display = mode === 'python' ? 'flex' : 'none';
    document.getElementById('mode-web').style.display    = mode === 'web'    ? 'flex' : 'none';

    document.getElementById('tab-python').classList.toggle('active', mode === 'python');
    document.getElementById('tab-web').classList.toggle('active', mode === 'web');

    const statusText = document.getElementById('cp-status-text');
    const subtitle   = document.getElementById('cp-subtitle');

    if (mode === 'python') {
        statusText.textContent = 'Python prêt';
        subtitle.innerHTML = 'Écrivez et exécutez du <a href="#">Python</a> directement dans votre navigateur – sans installation.';
        populateExamples('python');
        if (pyEditor) pyEditor.refresh();
    } else {
        statusText.textContent = 'HTML/CSS/JS prêt';
        subtitle.innerHTML = 'Construisez des pages web avec <a href="#">HTML</a>, <a href="#">CSS</a> et <a href="#">JavaScript</a>.';
        populateExamples('web');
        [webHtmlEditor, webCssEditor, webJsEditor].forEach(e => e && e.refresh());
        runWeb();
    }
}

// Mobile pane switching logic
function switchMobilePane(pane) {
    const tabs = document.querySelectorAll('.mobile-tab-btn');
    tabs.forEach(t => t.classList.remove('active'));
    
    // Find panels in the active mode
    const activeMode = document.querySelector('.mode-panel.active');
    if(!activeMode) return;
    
    const panels = activeMode.querySelectorAll('.cp-panel');
    if(panels.length < 2) return;
    
    if (pane === 'editor') {
        event.target.classList.add('active');
        panels[0].classList.remove('mobile-hidden');
        panels[1].classList.add('mobile-hidden');
    } else {
        event.target.classList.add('active');
        panels[0].classList.add('mobile-hidden');
        panels[1].classList.remove('mobile-hidden');
    }
}

// Ensure initial mobile state hides the console
window.addEventListener('DOMContentLoaded', () => {
    if (window.innerWidth <= 768) {
        switchMobilePane('editor');
    }
});

// ----------------------------------------------------------------
// EXAMPLES DROPDOWN
// ----------------------------------------------------------------
function populateExamples(mode) {
    const sel = document.getElementById('examples-select');
    sel.innerHTML = '<option value="">Exemples de code...</option>';
    const src = mode === 'python' ? PYTHON_EXAMPLES : WEB_EXAMPLES;
    for (const [key, val] of Object.entries(src)) {
        const opt = document.createElement('option');
        opt.value = key;
        opt.textContent = val.label;
        sel.appendChild(opt);
    }
}

function loadExample() {
    const key = document.getElementById('examples-select').value;
    if (!key) return;
    if (currentMode === 'python' && PYTHON_EXAMPLES[key]) {
        pyEditor.setValue(PYTHON_EXAMPLES[key].code);
        clearConsole();
        showConsoleWelcome();
    } else if (currentMode === 'web' && WEB_EXAMPLES[key]) {
        const ex = WEB_EXAMPLES[key];
        webHtmlEditor.setValue(ex.html || '');
        webCssEditor.setValue(ex.css || '');
        webJsEditor.setValue(ex.js || '');
        runWeb();
    }
}

