// WEB EXECUTION
// ----------------------------------------------------------------
function runWeb() {
    const html = webHtmlEditor ? webHtmlEditor.getValue() : '';
    const css  = webCssEditor  ? webCssEditor.getValue()  : '';
    const js   = webJsEditor   ? webJsEditor.getValue()   : '';

    const combined = `<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<style>${css}</style>
</head>
<body>
${html}
<script>
try { ${js} } catch(e) { document.body.innerHTML += '<div style="color:red;font-family:monospace;padding:16px;">Erreur JS: '+e.message+'</div>'; }
<\/script>
</body>
</html>`;

    const frame = document.getElementById('web-preview');
    const doc = frame.contentDocument || frame.contentWindow.document;
    doc.open(); doc.write(combined); doc.close();
}

function clearPreview() {
    const frame = document.getElementById('web-preview');
    const doc = frame.contentDocument || frame.contentWindow.document;
    doc.open(); doc.write('<html><body></body></html>'); doc.close();
}

// ----------------------------------------------------------------
// WEB TAB SWITCHING
// ----------------------------------------------------------------
function switchWebTab(tab) {
    currentWebTab = tab;
    document.querySelectorAll('.web-editor-tab').forEach((btn, i) => {
        const tabs = ['html','css','js'];
        btn.classList.toggle('active', tabs[i] === tab);
    });
    document.querySelectorAll('.web-pane').forEach(p => p.classList.remove('active'));
    document.getElementById('web-pane-' + tab).classList.add('active');

    const badges = { html: 'HTML', css: 'CSS', js: 'JavaScript' };
    const files  = { html: 'index.html', css: 'style.css', js: 'script.js' };
    document.getElementById('web-badge').textContent    = badges[tab];
    document.getElementById('web-filename').textContent = files[tab];

    const editors = { html: webHtmlEditor, css: webCssEditor, js: webJsEditor };
    if (editors[tab]) editors[tab].refresh();
}

