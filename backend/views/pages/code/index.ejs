// SMART INDENT + HINTS (Python)
// ----------------------------------------------------------------
function checkAndShowHint(code) {
    const hintEl = document.getElementById('py-hint');
    for (const hint of PYTHON_HINTS) {
        if (hint.trigger.test(code)) {
            hintEl.innerHTML = `💡 ${hint.fr}<br><span style="color:#a78bfa;font-size:11.5px;">${hint.ar}</span>`;
            hintEl.classList.add('show');
            return;
        }
    }
    hintEl.classList.remove('show');
}

const bugiCopy = JSON.parse(document.getElementById('ai-drawer').dataset.messages);
let bugiRequest = null;
let bugiReturnFocus = null;
let lastExplainedCode = null;

function toggleAiDrawer(forceOpen = null) {
    const drawer = document.getElementById('ai-drawer');
    const launcher = document.getElementById('ai-launcher');
    if (!drawer || !launcher) return;
    const open = forceOpen ?? drawer.hidden;
    if (open === !drawer.hidden) return;

    drawer.hidden = !open;
    launcher.setAttribute('aria-expanded', String(open));
    if (open) {
        bugiReturnFocus = document.activeElement;
        document.getElementById('ai-unread').hidden = true;
        launcher.setAttribute('aria-label', 'Réduire la conversation avec Bugi');
        document.getElementById('ai-close').focus();
        const history = document.getElementById('ai-chat-history');
        history.scrollTop = history.scrollHeight;
        if (!bugiHistoryLoaded) return loadBugiHistory();
    } else {
        launcher.setAttribute('aria-label', 'Ouvrir la conversation avec Bugi');
        if (bugiReturnFocus?.getClientRects().length) bugiReturnFocus.focus();
        else launcher.focus();
    }
}

document.getElementById('ai-drawer').addEventListener('keydown', event => {
    if (event.key === 'Escape') {
        event.stopPropagation();
        toggleAiDrawer(false);
    }
});

function makeBugiBubble(text, fromStudent = false) {
    const bubble = document.createElement('div');
    bubble.className = fromStudent ? 'ai-bubble user' : 'ai-bubble ai';
    bubble.dir = 'auto';
    if (!fromStudent) bubble.lang = 'ar';
    bubble.textContent = text;
    return bubble;
}

const BUGI_CODE_LIMIT = 12000;
let bugiAttachment = null;
let attachmentRevision = 0;

function updateBugiAttachment(attachment, notice = '') {
    bugiAttachment = attachment;
    document.getElementById('ai-attachment').hidden = !attachment && !notice;
    document.getElementById('ai-attachment-label').textContent = attachment?.label ?? notice;
}

function attachBugiCode(code, label) {
    if (!code.trim() || code.includes('\0') || code.length > BUGI_CODE_LIMIT) {
        updateBugiAttachment(null, 'Joins un extrait Python de 12 000 caractères maximum.');
        return;
    }
    updateBugiAttachment({ code, label });
}

const bugiFileInput = document.getElementById('ai-code-file');
document.getElementById('ai-attach-file').addEventListener('click', () => bugiFileInput.click());
document.getElementById('ai-attach-editor').addEventListener('click', () => {
    attachmentRevision++;
    attachBugiCode(pyEditor?.getValue() ?? '', 'Code de l’éditeur');
});
document.getElementById('ai-remove-attachment').addEventListener('click', () => {
    attachmentRevision++;
    updateBugiAttachment(null);
    document.getElementById('ai-user-input').focus();
});
bugiFileInput.addEventListener('change', async () => {
    const file = bugiFileInput.files[0];
    bugiFileInput.value = '';
    if (!file) return;
    const revision = ++attachmentRevision;
    if (!/\.py$/i.test(file.name) || file.size > BUGI_CODE_LIMIT * 4) {
        updateBugiAttachment(null, 'Choisis un petit fichier .py.');
        return;
    }

    updateBugiAttachment(null, 'Lecture du fichier…');
    try {
        const code = await file.text();
        if (revision === attachmentRevision) attachBugiCode(code, file.name);
    } catch {
        if (revision === attachmentRevision) updateBugiAttachment(null, 'Impossible de lire ce fichier.');
    }
});

function sendBugiMessage() {
    const input = document.getElementById('ai-user-input');
    const question = input.value.trim();
    if ((!question && !bugiAttachment) || bugiRequest || bugiHistoryLoading || bugiHistoryClearing) return;

    const attachment = bugiAttachment;
    input.value = '';
    const message = [question, attachment?.label].filter(Boolean).join('\n');
    requestBugi(message, { code: attachment?.code ?? '', question });
}

async function requestBugi(message, payload, onAnswer) {
    if (bugiRequest || bugiHistoryLoading || bugiHistoryClearing) return;

    const history = document.getElementById('ai-chat-history');
    const send = document.getElementById('ai-send-btn');
    const controller = new AbortController();
    bugiRequest = controller;
    send.disabled = true;
    const student = makeBugiBubble(message, true);
    history.append(student);

    const typing = document.createElement('div');
    typing.className = 'ai-typing';
    typing.setAttribute('role', 'status');
    typing.setAttribute('aria-label', bugiCopy.typing);
    for (let index = 0; index < 3; index++) {
        const dot = document.createElement('span');
        dot.setAttribute('aria-hidden', 'true');
        typing.append(dot);
    }
    history.append(typing);
    history.scrollTop = history.scrollHeight;

    const reply = makeBugiBubble('');
    try {
        const response = await fetch('/api/ai/debug', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload),
            signal: controller.signal
        });
        const data = response.ok ? await response.json().catch(() => null) : null;
        if (bugiRequest !== controller) return;

        if (typeof data?.explanation === 'string' && data.explanation.trim()) {
            showBugiAnswer(reply, data.explanation);
            for (const entry of data.saved ?? []) {
                const bubble = entry.role === 'student' ? student : reply;
                bubble.dataset.messageId = entry.id;
            }
            onAnswer?.();
        } else if (response.status === 401) {
            reply.textContent = bugiCopy.session;
        } else if (response.status === 429) {
            reply.textContent = bugiCopy.quota;
        } else {
            reply.textContent = response.status === 400 ? bugiCopy.invalid : bugiCopy.busy;
        }
    } catch {
        if (bugiRequest !== controller) return;
        reply.textContent = bugiCopy.connection;
    } finally {
        typing.remove();
        if (bugiRequest === controller) {
            bugiRequest = null;
            send.disabled = false;
        }
    }

    if (!reply.dataset.reply && payload.question) {
        const input = document.getElementById('ai-user-input');
        if (!input.value) input.value = payload.question;
    }
    history.append(reply);
    history.scrollTop = history.scrollHeight;
    if (document.getElementById('ai-drawer').hidden) {
        document.getElementById('ai-unread').hidden = false;
        document.getElementById('ai-launcher').setAttribute('aria-label', 'Ouvrir Bugi, nouveau message');
    }
}

// ----------------------------------------------------------------
// AI LOCAL STORAGE HISTORY
// ----------------------------------------------------------------
let bugiHistoryLoaded = false;
let bugiHistoryLoading = false;
let bugiHistoryClearing = false;
let bugiHistoryCursor = null;

function makeBugiCodeAction(icon, label, action) {
    const button = document.createElement('button');
    button.type = 'button';
    button.className = 'ai-tool';
    button.title = label;
    button.setAttribute('aria-label', label);
    const glyph = document.createElement('i');
    glyph.className = 'fas ' + icon;
    glyph.setAttribute('aria-hidden', 'true');
    button.append(glyph);
    button.addEventListener('click', action);
    return button;
}

function renderBugiAnswer(bubble, text) {
    const blocks = text.split(/```([a-zA-Z0-9_+-]*)[ \t]*\r?\n([\s\S]*?)```/);
    for (let index = 0; index < blocks.length; index += 3) {
        bubble.append(document.createTextNode(blocks.length > 1 ? blocks[index].trim() : blocks[index]));
        if (index + 2 >= blocks.length) continue;

        const language = blocks[index + 1].toLowerCase();
        const snippet = blocks[index + 2].trimEnd();
        const pre = document.createElement('pre');
        const code = document.createElement('code');
        code.textContent = snippet;
        pre.append(code);

        const actions = document.createElement('div');
        actions.className = 'ai-code-actions';
        actions.dir = 'ltr';
        const copy = makeBugiCodeAction('fa-copy', 'Copier le code', async () => {
            try {
                await navigator.clipboard.writeText(snippet);
                copy.title = 'Code copié';
                copy.setAttribute('aria-label', copy.title);
                copy.firstChild.className = 'fas fa-check';
            } catch {
                copy.title = 'Copie indisponible';
                copy.setAttribute('aria-label', copy.title);
            }
        });
        actions.append(copy);
        if (snippet.trim() && ['', 'python', 'py', 'python3'].includes(language)) {
            const run = makeBugiCodeAction('fa-play', 'Remplacer le code de l’éditeur et exécuter', () => {
                if (!pyEditor || pythonRunInProgress) return;
                pyEditor.setValue(snippet);
                toggleAiDrawer(false);
                if (window.matchMedia('(max-width: 700px)').matches) switchMobilePane('console');
                runPython();
            });
            run.classList.add('ai-run');
            actions.append(run);
        }
        bubble.append(pre, actions);
    }
}

function showBugiAnswer(bubble, text) {
    bubble.dataset.reply = text;
    renderBugiAnswer(bubble, text);
}

async function loadBugiHistory() {
    if (bugiRequest || bugiHistoryLoading || bugiHistoryClearing || (bugiHistoryLoaded && !bugiHistoryCursor)) return;
    const history = document.getElementById('ai-chat-history');
    const more = document.getElementById('ai-history-more');
    const cursor = bugiHistoryCursor;
    bugiHistoryLoading = true;
    more.disabled = true;

    try {
        const response = await fetch(cursor ? '/api/ai/history?before=' + encodeURIComponent(cursor) : '/api/ai/history');
        if (!response.ok) throw new Error('History unavailable');
        const data = await response.json();
        const bubbles = document.createDocumentFragment();
        const existing = new Set([...history.querySelectorAll('[data-message-id]')].map(node => node.dataset.messageId));
        for (const entry of data.messages) {
            if (existing.has(entry.id)) continue;
            const student = entry.role === 'student';
            const bubble = makeBugiBubble(student ? entry.message : '', student);
            bubble.dataset.messageId = entry.id;
            if (!student) renderBugiAnswer(bubble, entry.message);
            bubbles.append(bubble);
        }
        const priorHeight = history.scrollHeight;
        const priorTop = history.scrollTop;
        history.querySelector('.ai-welcome').after(bubbles);
        history.scrollTop = cursor ? priorTop + history.scrollHeight - priorHeight : history.scrollHeight;
        bugiHistoryLoaded = true;
        bugiHistoryCursor = data.next;
        more.textContent = 'Messages précédents';
        more.hidden = !data.next;
    } catch {
        more.textContent = 'Réessayer de charger l’historique';
        more.hidden = false;
    } finally {
        bugiHistoryLoading = false;
        more.disabled = false;
    }
}

async function clearBugiHistory() {
    if (bugiHistoryClearing || bugiHistoryLoading || bugiRequest) return;
    if (!confirm("Effacer l’historique avec Bugi sur tous tes appareils ?")) return;
    bugiHistoryClearing = true;
    const history = document.getElementById('ai-chat-history');
    try {
        const response = await fetch('/api/ai/history', { method: 'DELETE' });
        if (!response.ok) throw new Error('History unavailable');
        bugiHistoryLoaded = true;
        bugiHistoryCursor = null;
        lastExplainedCode = null;
        document.getElementById('ai-history-more').hidden = true;
        document.getElementById('ai-unread').hidden = true;
        history.querySelectorAll('.ai-bubble').forEach(node => node.remove());
    } catch {
        history.append(makeBugiBubble(bugiCopy.busy));
        history.scrollTop = history.scrollHeight;
    } finally {
        bugiHistoryClearing = false;
    }
}

function triggerBugiError() {
    // Highlight the AI button to draw attention contextually
    const aiBtn = document.querySelector('.cp-ai-btn');
    if (aiBtn) {
        aiBtn.style.animation = 'pulse-dot 1.5s infinite';
        setTimeout(() => { aiBtn.style.animation = ''; }, 4500);
    }
}

async function askAiDebugger() {
    await toggleAiDrawer(true);
    if (bugiRequest || bugiHistoryLoading || bugiHistoryClearing) return;

    const code = pyEditor?.getValue() ?? '';
    if (!code.trim()) {
        document.getElementById('ai-user-input').focus();
        return;
    }

    if (code === lastExplainedCode) {
        const history = document.getElementById('ai-chat-history');
        history.append(makeBugiBubble(bugiCopy.alreadyExplained));
        history.scrollTop = history.scrollHeight;
            return;
    }

    const errors = code === lastPythonRunCode
        ? [...document.querySelectorAll('#py-console .console-error')]
        : [];
    const error = errors.map(node => node.textContent).join('\n').slice(0, 3000);
    requestBugi(
        error ? bugiCopy.debugError : bugiCopy.reviewCode,
        { code, error },
        () => { lastExplainedCode = code; }
    );
}

// ----------------------------------------------------------------
// INIT — mount CodeMirror editors
// ----------------------------------------------------------------
function initEditors() {
    // Clear any previous CodeMirror instances from DOM
    ['py-editor-body','web-pane-html','web-pane-css','web-pane-js'].forEach(id => {
        const el = document.getElementById(id);
        if (el) {
            const cm = el.querySelector('.CodeMirror');
            if (cm) cm.remove();
        }
    });

    // ---- PYTHON editor ----
    pyEditor = CodeMirror(document.getElementById('py-editor-body'), {
        value: readCodeDraft('python', CP_FIRST_USE_CODE),
        placeholder: '# Ecrivez votre code Python ici...',
        mode: 'python',
        theme: 'synta',
        lineNumbers: true,
        matchBrackets: true,
        autoCloseBrackets: true,
        indentUnit: 4,
        tabSize: 4,
        indentWithTabs: false,
        lineWrapping: true,
        extraKeys: {
            'Ctrl-Enter': runPython,
            'Enter': function(cm) {
                const cursor  = cm.getCursor();
                const line    = cm.getLine(cursor.line);
                const trimmed = line.trimEnd();
                if (trimmed.endsWith(':')) {
                    const indent = line.match(/^\s*/)[0];
                    cm.replaceSelection('\n' + indent + '    ');
                } else {
                    cm.execCommand('newlineAndIndent');
                }
            }
        }
    });

    // ---- WEB editors — initialize ALL even if hidden so CodeMirror has correct size ----
    // We force them visible temporarily, init, then hide again
    var htmlPane = document.getElementById('web-pane-html');
    var cssPane  = document.getElementById('web-pane-css');
    var jsPane   = document.getElementById('web-pane-js');

    webHtmlEditor = CodeMirror(htmlPane, {
        value: readCodeDraft('html', '<!-- Écris ton HTML ici -->\n<h1>Bonjour, Synta Academy !</h1>\n<p>Teste ta page web ici.</p>'),
        mode: 'htmlmixed',
        theme: 'dracula',
        lineNumbers: true,
        matchBrackets: true,
        autoCloseBrackets: true,
        indentUnit: 2,
        tabSize: 2,
        lineWrapping: true,
        extraKeys: { 'Ctrl-Enter': runWeb }
    });

    webCssEditor = CodeMirror(cssPane, {
        value: readCodeDraft('css', '/* Ton CSS ici */\nbody {\n  font-family: sans-serif;\n  text-align: center;\n  padding: 40px;\n  background: #f0f4ff;\n}\nh1 { color: #ff7b1a; }'),
        mode: 'css',
        theme: 'dracula',
        lineNumbers: true,
        matchBrackets: true,
        autoCloseBrackets: true,
        indentUnit: 2,
        tabSize: 2,
        extraKeys: { 'Ctrl-Enter': runWeb }
    });

    webJsEditor = CodeMirror(jsPane, {
        value: readCodeDraft('javascript', '// Ton JavaScript ici\nconsole.log("Page chargée !");'),
        mode: 'javascript',
        theme: 'dracula',
        lineNumbers: true,
        matchBrackets: true,
        autoCloseBrackets: true,
        indentUnit: 2,
        tabSize: 2,
        extraKeys: { 'Ctrl-Enter': runWeb }
    });

    pyEditor.on('change', editor => saveCodeDraft('python', editor.getValue()));
    webHtmlEditor.on('change', editor => saveCodeDraft('html', editor.getValue()));
    webCssEditor.on('change', editor => saveCodeDraft('css', editor.getValue()));
    webJsEditor.on('change', editor => saveCodeDraft('javascript', editor.getValue()));

    // Refresh all editors after a short delay to fix hidden-pane sizing
    setTimeout(function() {
        pyEditor.refresh();
        webHtmlEditor.refresh();
        webCssEditor.refresh();
        webJsEditor.refresh();
        // Set cursor to line 0 col 0 (no blank space scroll offset)
        pyEditor.setCursor(0, 0);
        webHtmlEditor.setCursor(0, 0);
        webCssEditor.setCursor(0, 0);
        webJsEditor.setCursor(0, 0);
    }, 50);

    // Keep the deferred Web workspace dormant until its mode is reintroduced.
    populateExamples('python');
}

// ----------------------------------------------------------------
// BOOT
// ----------------------------------------------------------------
function boot() {
    // Guard: only run on the Code Pratique page
    const pyBody = document.getElementById('py-editor-body');
    if (!pyBody) return;

    // DOMContentLoaded and Turbo can both call boot for one visit. Rebuilding
    // CodeMirror here would erase a lesson file applied by the first call.
    const existingWrapper = pyEditor?.getWrapperElement?.();
    if (existingWrapper && pyBody.contains(existingWrapper)) {
        loadPracticeStarterFile();
        pyEditor.refresh();
        return;
    }

    // Relocate AI wrapper to body root to prevent CSS clipping
    const aiWrapper = document.getElementById('ai-wrapper-global');
    if (aiWrapper && aiWrapper.parentNode !== document.body) {
        document.body.appendChild(aiWrapper);
    }

    pyEditor = null; webHtmlEditor = null; webCssEditor = null; webJsEditor = null;
    initEditors();
    loadPracticeStarterFile();
    clearConsole();
    showConsoleWelcome();
}

function loadPracticeStarterFile() {
    // Leave the queued file untouched until CodeMirror is ready to receive it.
    if (!pyEditor) return;
    let starter;
    try {
        starter = JSON.parse(sessionStorage.getItem('synta:practice-starter') || 'null');
        sessionStorage.removeItem('synta:practice-starter');
    } catch (error) {
        sessionStorage.removeItem('synta:practice-starter');
        console.error('Could not read the selected lesson file:', error);
        return;
    }
    if (!starter || typeof starter.code !== 'string') return;
    switchMode('python');
    pyEditor.setValue(starter.code);
    saveCodeDraft('python', starter.code);
    document.getElementById('practice-file-name').textContent = starter.fileName || 'exercice.py';
    document.getElementById('practice-file-notice').hidden = false;
    document.getElementById('python-filename').textContent = starter.fileName || 'exercice.py';
}

if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', boot);
} else {
    boot();
}

// Turbo SPA: always re-boot when the page is loaded (DOM may have changed)
document.addEventListener('turbo:load', function() {
    // Check if CodeMirror is actually mounted in the current DOM
    var pyBody = document.getElementById('py-editor-body');
    if (!pyBody) return; // not on this page
    var existingWrapper = pyEditor?.getWrapperElement?.();
    var editorMatchesCurrentPage = !!existingWrapper && pyBody.contains(existingWrapper);
    if (!editorMatchesCurrentPage) { boot(); }
    else {
        // A Turbo visit can carry a newly queued course file into an editor
        // that is already mounted; consume it after the page becomes active.
        loadPracticeStarterFile();
        // Editor is there — just refresh layout
        if (pyEditor) pyEditor.refresh();
        if (webHtmlEditor) webHtmlEditor.refresh();
        if (webCssEditor)  webCssEditor.refresh();
        if (webJsEditor)   webJsEditor.refresh();
    }
});
