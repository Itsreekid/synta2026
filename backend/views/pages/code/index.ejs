// TOOLBAR ACTIONS
// ----------------------------------------------------------------
function clearEditor() {
    if (currentMode === 'python') { pyEditor.setValue(''); }
    else { webHtmlEditor.setValue(''); webCssEditor.setValue(''); webJsEditor.setValue(''); }
}

function copyCode() {
    let code = '';
    if (currentMode === 'python') code = pyEditor.getValue();
    else if (currentWebTab === 'html') code = webHtmlEditor.getValue();
    else if (currentWebTab === 'css')  code = webCssEditor.getValue();
    else code = webJsEditor.getValue();
    navigator.clipboard.writeText(code).then(() => {
        const btn = document.querySelector('.cp-btn-toolbar:last-child');
        btn.innerHTML = '<i class="fas fa-check"></i> Copié !';
        setTimeout(() => btn.innerHTML = '<i class="fas fa-copy"></i> Copier', 1500);
    });
}

// ----------------------------------------------------------------
// PYTHON EXECUTION (Skulpt)
// ----------------------------------------------------------------
// ----------------------------------------------------------------
// INPUT MODAL helpers
// ----------------------------------------------------------------
function showInputModal(prompt) {
    return new Promise((resolve) => {
        const overlay = document.getElementById('input-modal-overlay');
        const promptEl = document.getElementById('input-modal-prompt');
        const field    = document.getElementById('input-modal-field');
        const okBtn    = document.getElementById('input-modal-ok');

        // Show the prompt text (what the student passed to input())
        promptEl.textContent = prompt || 'Entrez une valeur :';
        field.value = '';
        overlay.classList.add('show');
        setTimeout(() => field.focus(), 80);

        // Show prompt in console too
        appendConsole('<span class="console-input-prompt">' + escapeHtml(prompt) + '</span>');

        function submit() {
            const val = field.value;
            overlay.classList.remove('show');
            okBtn.removeEventListener('click', submit);
            field.removeEventListener('keydown', keyHandler);
            // Echo the typed value in console
            appendConsole('<span class="console-output">' + escapeHtml(val) + '</span>\n');
            resolve(val);
        }

        function keyHandler(e) {
            if (e.key === 'Enter') { e.preventDefault(); submit(); }
        }

        okBtn.addEventListener('click', submit);
        field.addEventListener('keydown', keyHandler);
    });
}

// ================================================================
// EXPORT LOGIC
// ================================================================
function exportPythonCode() {
    if (!pyEditor) return;
    const code = pyEditor.getValue();
    const blob = new Blob([code], { type: 'text/x-python;charset=utf-8' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = 'mon_code.py';
    document.body.appendChild(a);
    a.click();
    document.body.removeChild(a);
    URL.revokeObjectURL(url);
}

function runPython() {
    const code = pyEditor.getValue().trim();
    if (!code) return;

    clearConsole();
    appendConsole('<span class="console-comment">▶ Exécution en cours...</span>\n');

    const statusEl = document.getElementById('cp-status-text');
    statusEl.textContent = '⏳ Exécution...';

    function outf(text) { appendConsole('<span class="console-output">' + escapeHtml(text) + '</span>'); }
    function errf(err)  {
        const msg = err.toString();
        const trans = translateError(msg);
        appendConsole(
            '<span class="console-error">❌ ' + escapeHtml(trans.fr) + '\n' +
            '   ' + escapeHtml(trans.ar) + '</span>\n'
        );
    }

    Sk.configure({
        output: outf,
        // input() handler — shows beautiful modal, returns Promise
        inputfun: (prompt) => showInputModal(prompt || ''),
        inputfunTakesPrompt: true,
        read: (x) => {
            if (Sk.builtinFiles === undefined || Sk.builtinFiles["files"][x] === undefined)
                throw "Fichier introuvable : '" + x + "'";
            return Sk.builtinFiles["files"][x];
        },
        execLimit: 30000
    });

    const promise = Sk.misceval.asyncToPromise(() =>
        Sk.importMainWithBody("<stdin>", false, code, true)
    );

    promise.then(
        (module) => {
            appendConsole('<span class="console-comment">\n✅ Programme terminé.</span>\n');
            statusEl.textContent = 'Python prêt';
            if(module && module.$d) {
                renderStateVisualizer(module.$d);
            }
        },
        (err) => {
            errf(err);
            statusEl.textContent = 'Python prêt';
        }
    );
}

function renderStateVisualizer(dict) {
    const vis = document.getElementById('py-visualizer');
    if (!vis) return;
    vis.innerHTML = ''; 

    const ignored = ['__name__', '__doc__', '__package__', '__loader__', '__spec__', '__annotations__', '__builtins__', '__file__', '__cached__'];
    let count = 0;

    for (const [key, pyObj] of Object.entries(dict)) {
        if (ignored.includes(key)) continue;
        if (typeof pyObj === 'function' || !pyObj || typeof pyObj.v === 'undefined') continue; 

        count++;
        let val = pyObj.v;
        let typeStr = 'UNKNOWN';
        let valClass = '';
        let valStr = String(val);

        if (typeof val === 'number') {
            typeStr = Number.isInteger(val) ? 'ENTIER' : 'RÉEL';
            valClass = 'vis-val-number';
        } else if (typeof val === 'string') {
            typeStr = 'CHAÎNE';
            valClass = 'vis-val-string';
            valStr = `"${val}"`;
        } else if (typeof val === 'boolean') {
            typeStr = 'BOOLÉEN';
            valClass = 'vis-val-bool';
            valStr = val ? "Vrai" : "Faux";
        } else if (Array.isArray(val)) {
            typeStr = 'TABLEAU';
            valClass = 'vis-val-list';
            valStr = '[' + val.map(v => (v && typeof v.v !== 'undefined') ? v.v : String(v)).join(', ') + ']';
        } else {
            typeStr = 'OBJET';
        }

        const card = document.createElement('div');
        card.className = 'vis-card';
        card.innerHTML = `
            <div class="vis-header">
                <span class="vis-var-name">${escapeHtml(key)}</span>
                <span class="vis-var-type">${typeStr}</span>
            </div>
            <div class="vis-var-value ${valClass}">${escapeHtml(valStr)}</div>
        `;
        vis.appendChild(card);
    }

    if (count === 0) {
        vis.innerHTML = `
            <div class="cp-visualizer-empty">
                <i class="fas fa-search" style="font-size: 24px; margin-bottom: 8px; opacity: 0.5;"></i><br>
                Aucune variable en mémoire.
            </div>`;
    }
}

function clearConsole() {
    document.getElementById('py-console').innerHTML = '';
    document.getElementById('py-hint').classList.remove('show');
    const vis = document.getElementById('py-visualizer');
    if (vis) {
        vis.innerHTML = `
            <div class="cp-visualizer-empty">
                <i class="fas fa-search" style="font-size: 24px; margin-bottom: 8px; opacity: 0.5;"></i><br>
                Aucune variable en mémoire. Exécutez le code pour visualiser.
            </div>`;
    }
}

function showConsoleWelcome() {
    appendConsole('<span class="console-ready">Python 3.10 prêt !</span>\n');
    appendConsole('<span class="console-comment"># Écrivez du code et Cliquez Exécuter</span>\n');
    appendConsole('<span class="console-comment"># Raccourci : Ctrl + Enter</span>\n');
}

function appendConsole(html) {
    const c = document.getElementById('py-console');
    c.innerHTML += html;
    c.scrollTop = c.scrollHeight;
}

function escapeHtml(str) {
    return String(str)
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;');
}

// ----------------------------------------------------------------
// WEB EXECUTION
// ----------------------------------------------------------------
function runWeb() {
    const html = webHtmlEditor ? webHtmlEditor.getValue() : '';
    const css  = webCssEditor  ? webCssEditor.getValue()  : '';
    const js   = webJsEditor   ? webJsEditor.getValue()   : '';

    const combined = `<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<style>${css}</style>
</head>
<body>
${html}
<script>
try { ${js} } catch(e) { document.body.innerHTML += '<div style="color:red;font-family:monospace;padding:16px;">Erreur JS: '+e.message+'</div>'; }
<\/script>
</body>
</html>`;

    const frame = document.getElementById('web-preview');
    const doc = frame.contentDocument || frame.contentWindow.document;
    doc.open(); doc.write(combined); doc.close();
}

function clearPreview() {
    const frame = document.getElementById('web-preview');
    const doc = frame.contentDocument || frame.contentWindow.document;
    doc.open(); doc.write('<html><body></body></html>'); doc.close();
}

