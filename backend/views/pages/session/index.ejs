<!doctype html>
<html lang="fr" dir="ltr">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>
<%= campaign ? campaign.title : 'Défi gratuit' %> · Synta Academy</title>
<meta name="description" content="Un défi gratuit pour découvrir ton niveau en informatique et participer à une séance Synta Academy.">
<link rel="stylesheet" href="/css/session.css?v=4">
</head>
<body class="campaign-page">
<a class="skip-link" href="#campaign-main">Aller au défi</a>
<header class="campaign-header">
<a class="brand" href="/">
<img src="/source/logo.webp" width="56" height="52" alt="Synta Academy">
<span>Synta Academy</span>
</a>
<a href="<%= viewer ? '/dashboard' : '/login'+(campaign ? '?next='+encodeURIComponent('/session/'+campaign.slug) : '') %>"><%= viewer ? 'Mon tableau de bord' : 'J’ai déjà un compte' %> <span aria-hidden="true">↗</span>
</a>
</header>
<main id="campaign-main" class="campaign-shell">
<% if (!campaign) { %>
<section class="challenge-card">
<h1>Ce défi n’est plus disponible.</h1>
<p>Retrouve nos prochaines découvertes sur Synta Academy.</p>
<a class="button primary" href="/">Retour à l’accueil</a>
</section>
<% } else { %>
<section id="landing" class="campaign-intro">
<div class="intro-copy">
<span class="eyebrow">DÉFI INFORMATIQUE GRATUIT</span>
<h1>
<%= campaign.title %>
</h1>
<p class="intro-description">
<%= campaign.description || 'Quelques questions pour découvrir tes acquis, puis une séance pour progresser ensemble.' %>
</p>
<div class="meta-chips">
<span id="campaign-target">
<%= campaign.subject %>
</span>
<span id="challenge-count">Chargement du défi…</span>
<span id="challenge-duration">
</span>
</div>
<button class="button primary" id="challenge-start" disabled>Chargement…</button>
<div class="journey">
<span>
<b>1</b> Relève le défi</span>
<span>
<b>2</b> Découvre ton niveau</span>
<span>
<b>3</b> Réserve ta séance</span>
</div>
</div>
<aside class="session-invite">
<span class="calendar-symbol" aria-hidden="true">▦</span>
<p class="eyebrow">TA PROCHAINE SÉANCE GRATUITE</p>
<h2 id="upcoming-date">
<%= campaign.date || 'Date bientôt annoncée' %>
</h2>
<p>Un cours pour poser tes questions et découvrir la plateforme.</p>
<label for="occurrence-select">Choisir une date<select id="occurrence-select">
<option value="">Prochaine séance disponible</option>
</select>
</label>
<p class="hint">Le bouton Rejoindre s’ouvre 5 minutes avant le début.</p>
</aside>
</section>
<section class="challenge-card" id="experience" aria-live="polite">
<noscript>Active JavaScript pour commencer ce défi interactif.</noscript>
<div id="experience-error" class="notice error" role="alert" hidden>
</div>
<div id="start-panel">
<span class="step-label">À ton rythme, depuis ton téléphone</span>
<h2>Prêt à essayer ?</h2>
<p>Ce court diagnostic t’aide à choisir la suite de ton apprentissage. Aucun paiement.</p>
<p class="hint" id="guest-note">Les réponses sont évaluées par Synta Academy.</p>
<% if (viewer && !viewer.isStudent) { %>
<p class="notice">Aperçu administrateur. Les comptes administrateurs ne sont pas inscrits comme étudiants.</p>
<% } %>
</div>
<div id="identity-panel" hidden>
<span class="step-label">Enregistre ton résultat</span>
<h2>Un compte, toutes tes découvertes.</h2>
<p id="identity-description">Confirme ton e-mail pour retrouver ton résultat et réserver ta séance.</p>
<form id="identity-form">
<p id="campaign-profile-info" class="notice" hidden></p>
<div class="form-grid">
<label>Nom complet<input id="full_name" autocomplete="name" maxlength="150" required>
</label>
<label>E-mail<input id="email" type="email" autocomplete="email" maxlength="254" required>
</label>
<label>Téléphone<input id="phone" type="tel" autocomplete="tel" maxlength="40" required placeholder="+216 …">
</label>
<label>Classe<select id="profile-class" required>
<option value="">Choisir ma classe</option>
<option value="1ere">1ère année</option>
<option value="2eme">2ème année</option>
<option value="3eme">3ème année</option>
<option value="bac">Baccalauréat</option>
<option value="other">Autre</option>
</select>
</label>
<label>Section<select id="profile-branch" required>
<option value="">Choisir ma section</option>
<option value="informatique">Informatique</option>
<option value="sciences">Sciences expérimentales</option>
<option value="mathematiques">Mathématiques</option>
<option value="technique">Sciences techniques</option>
<option value="economie">Économie et gestion</option>
<option value="lettres">Lettres</option>
<option value="other">Autre</option>
</select>
</label>
</div>
<div id="identity-error" class="notice error" role="alert" hidden>
</div>
<p id="identity-notice" class="notice" role="status" hidden>
</p>
<button class="button primary" id="identity-submit">Recevoir mon lien de confirmation</button>
</form>
<p class="hint">Ton mot de passe sera créé après vérification de ton adresse. <a href="/login?next=<%= encodeURIComponent('/session/'+campaign.slug) %>">Déjà inscrit ? Connecte-toi</a>.</p>
</div>
<div id="quiz-panel" hidden>
<div class="quiz-header">
<span id="quiz-progress-text" class="step-label">
</span>
<span class="quiz-note">Un pas à la fois</span>
</div>
<div class="progress-track" role="progressbar" aria-label="Progression du défi" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0">
<div id="quiz-progress-bar">
</div>
</div>
<div id="question-container" tabindex="-1">
</div>
<p id="quiz-error" class="notice error" role="alert" hidden>
</p>
<div class="quiz-actions">
<button class="button secondary" id="btn-prev">Précédente</button>
<button class="button primary" id="btn-next">Continuer</button>
<button class="button primary" id="btn-submit" hidden>Voir mon résultat</button>
</div>
<p class="hint">Tu peux revenir à une question avant d’envoyer tes réponses.</p>
</div>
<div id="result-panel" hidden>
<span class="result-symbol" aria-hidden="true">✓</span>
<span class="step-label">TON POINT DE DÉPART</span>
<h2 id="success-tier-name">
</h2>
<p class="result-score">
<strong id="success-score">
</strong>
<span id="result-percent">
</span>
</p>
<p id="result-message">
</p>
<p id="result-recommendation" class="recommendation">
</p>
<p class="hint">Un court diagnostic, pas une certification. Il ne mesure pas toutes tes compétences.</p>
<p id="reservation-confirmation" class="notice" hidden>
</p>
<button class="button primary" id="save-result">Enregistrer mon résultat et réserver ma séance gratuite</button>
<a class="button secondary" id="member-session-link" href="/dashboard" hidden>Découvrir mon tableau de bord</a>
<button class="text-button" id="retry-challenge">Refaire le défi</button>
<div class="explore-links">
<a href="/app/courses">Explorer les aperçus de cours</a>
<a href="/app/code-pratique">Découvrir Code Pratique</a>
</div>
</div>
</section>
<p class="page-note">Un résultat utile. Une vraie séance. Une seule plateforme pour progresser.</p>
<% } %>
</main>
<footer>© Synta Academy · Informatique en Tunisie <a href="/#contact">Nous contacter</a>
</footer>
<dialog id="password-modal" aria-labelledby="password-title">
<form id="password-form">
<button class="dialog-close" type="button" id="close-password" aria-label="Fermer">×</button>
<span class="step-label">E-mail confirmé</span>
<h2 id="password-title">Garde ton résultat avec toi.</h2>
<label>Mot de passe<input id="modal-password" type="password" autocomplete="new-password" minlength="6" maxlength="72" required>
</label>
<label>Confirmer le mot de passe<input id="modal-password-confirm" type="password" autocomplete="new-password" minlength="6" maxlength="72" required>
</label>
<p id="modal-error" class="notice error" role="alert" hidden>
</p>
<button class="button primary" id="btn-confirm-password">Créer mon compte et réserver</button>
</form>
</dialog>
<script>window.__SESSION__=<%- JSON.stringify(campaign ? {slug:campaign.slug,member:Boolean(viewer&&viewer.isStudent),preview:Boolean(viewer&&!viewer.isStudent),hasPlacement:Boolean(locals.hasPlacement)}:null).replace(/</g,'\\u003c') %>;</script>
<% if(campaign) { %>
<script src="/js/session.js?v=6" defer>
</script>
<% } %>
</body>
</html>
