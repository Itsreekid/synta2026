<!DOCTYPE html>
<html lang="fr" dir="ltr">
<head>
    <%- include('../../partials/head', { title: 'Calendrier des Sessions', css: 'calendar' }) %>
</head>
<body>
    <div id="global-hydration-overlay"><div class="spinner"></div></div>
    <%- include('../../partials/header') %>

    <div class="content-wrapper">
        <%- include('../../partials/sidebar', { active: 'calendar' }) %>

        <section id="main-section" class="main-section">
            <div class="calendar-container">
                <!-- Header -->
                <div class="calendar-header">
                    <h1>📅 Calendrier des Sessions</h1>
                    <div class="header-controls">
                        <button class="nav-btn" onclick="previousWeek()">◀ Semaine précédente</button>
                        <button class="today-btn" onclick="goToToday()">Aujourd'hui</button>
                        <button class="nav-btn" onclick="nextWeek()">Semaine suivante ▶</button>
                    </div>
                </div>

                <!-- Calendar Info -->
                <div class="calendar-info">
                    <h2 id="current-week-range">Chargement...</h2>
                    <p id="event-count-text">Aucun événement cette semaine</p>
                </div>

                <!-- Week Calendar -->
                <div class="week-calendar">
                    <div id="calendar-grid" class="calendar-grid">
                        <!-- Days generated dynamically by calendar.js -->
                    </div>
                </div>

                <!-- Event Details Modal -->
                <div id="event-modal" class="modal">
                    <div class="modal-content">
                        <span class="close" onclick="closeModal()">&times;</span>
                        <div id="modal-body">
                            <!-- Event details inserted here -->
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </div>

    <!-- Scripts
         NOTE: The static /data/events.js script tag has been removed.
         Events are fetched via GET /api/events (server-filtered). -->
    <script src="/js/authentication.js"></script>
    <script src="/js/user.js"></script>
    <script src="/js/calendar.js"></script>
</body>
</html>
