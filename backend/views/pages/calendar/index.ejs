<!DOCTYPE html>
<html lang="fr" dir="ltr">
<head>
    <%- include('../../partials/head', { turboReload: true, title: 'Calendrier des Sessions', css: 'calendar' }) %>
<link rel="stylesheet" href="/css/learning-player.css?v=2">
<link rel="stylesheet" href="/vendor/videojs/10.6.0/global.css">
</head>
<body>
    <div id="global-hydration-overlay"><div class="spinner"></div></div>
    <%- include('../../partials/header') %>

    <div class="content-wrapper">
        <%- include('../../partials/sidebar', { active: 'calendar' }) %>

        <section id="main-section" class="main-section">
            <div class="calendar-container">
                <!-- Header -->
                <div class="calendar-header">
                    <div class="calendar-heading">
                        <h1><svg class="calendar-heading-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="M8 2v4m8-4v4M3 10h18M5 4h14a2 2 0 0 1 2 2v14H3V6a2 2 0 0 1 2-2"/></svg> Calendrier des Sessions</h1>
                        <p id="event-count-text">Aucun événement cette semaine</p>
                    </div>
                    <div class="header-controls">
                        <button type="button" class="nav-btn" onclick="previousWeek()" aria-label="Semaine précédente"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="m15 5-7 7 7 7"/></svg><span class="nav-label">Précédente</span></button>
                        <h2 id="current-week-range">Chargement...</h2>
                        <button type="button" class="nav-btn" onclick="nextWeek()" aria-label="Semaine suivante"><span class="nav-label">Suivante</span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="m9 5 7 7-7 7"/></svg></button>
                        <button type="button" class="today-btn" onclick="goToToday()">Aujourd'hui</button>
                    </div>
                </div>

                <!-- Week Calendar -->
                <div class="week-calendar">
                    <div id="calendar-grid" class="calendar-grid">
                        <!-- Days generated dynamically by calendar.js -->
                    </div>
                </div>


            </div>
        </section>
    </div>

    <!-- Scripts
         NOTE: The static /data/events.js script tag has been removed.
         Events are fetched via GET /api/events (server-filtered). -->
    <script src="/js/authentication.js"></script>
    <script src="/js/user.js?v=20261125-live"></script>
    <script src="/js/learning-player.js?v=2"></script>
    <script src="/js/replay-player.js"></script>
    <script src="/js/calendar.js?v=20261125-calendar"></script>
</body>
</html>
