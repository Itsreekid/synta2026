<!DOCTYPE html>
<html lang="fr" dir="ltr">
<head>
    <%- include('../../partials/head', { turboReload: true, title: 'Mon Profil' }) %>
</head>
<body>
    <div id="global-hydration-overlay"><div class="spinner"></div></div>
    <%- include('../../partials/header') %>

    <div class="content-wrapper">
        <%- include('../../partials/sidebar', { active: 'profile' }) %>

        <section id="main-section" class="main-section">
            <div class="page-profile-wrapper">
                <div class="profile-container tw-mx-auto tw-w-full tw-max-w-[1400px] max-[768px]:tw-p-3">
                <div class="profile-header tw-mb-6 tw-text-center">
                    <h1 class="sa-page-title tw-justify-center"><i class="fas fa-user-circle tw-text-brand-500" aria-hidden="true"></i> Profil</h1>
                    <p class="sa-page-subtitle">Gérez vos informations personnelles et votre progrès éducatif</p>
                </div>

                <div class="profile-content tw-flex tw-flex-col tw-gap-5 min-[1025px]:tw-grid min-[1025px]:tw-grid-cols-[2fr_1fr] min-[1025px]:tw-items-start min-[1025px]:tw-gap-6">
                    <div class="profile-main tw-flex tw-min-w-0 tw-flex-col tw-gap-5">
                        <section class="profile-section sa-card sa-card--pad tw-border-l-4 tw-border-l-teal-500" id="email-verification-reminder" hidden aria-labelledby="email-verification-title">
                            <h2 class="sa-card__title" id="email-verification-title"><i class="fas fa-envelope-open-text" aria-hidden="true"></i> Confirmer mon adresse e-mail</h2>
                            <p class="tw-mb-4 tw-mt-2 tw-leading-relaxed tw-text-slate-600">Tu peux continuer à utiliser ton espace. Confirme ton e-mail quand tu le souhaites pour sécuriser ton compte.</p>
                            <button type="button" class="btn btn-primary sa-btn sa-btn--primary" id="send-email-verification">Recevoir un lien de confirmation</button>
                            <p id="email-verification-feedback" class="tw-mb-0 tw-mt-3 tw-text-sm tw-text-slate-600" role="status"></p>
                        </section>
                        <!-- Personal Information
                             Fields are pre-filled server-side. JS (profile.js) may
                             update them after Supabase client auth resolves, but the
                             form is always immediately usable on page load. -->
                        <div class="profile-section sa-card sa-card--pad">
                            <h2 class="sa-card__title tw-mb-5"><i class="fas fa-id-card" aria-hidden="true"></i> Informations personnelles</h2>
                            <div class="profile-form">
                                <div class="form-group sa-field">
                                    <label class="sa-label" for="full-name">Nom complet</label>
                                    <input type="text" class="sa-input"
                                           id="full-name"
                                           placeholder="Entrez votre nom complet"
                                           value="<%= (typeof profile !== 'undefined' && profile) ? profile.full_name : '' %>">
                                </div>
                                <div class="form-group sa-field">
                                    <label class="sa-label" for="email">Adresse e-mail</label>
                                    <input type="email" class="sa-input"
                                           id="email"
                                           placeholder="Entrez votre e-mail"
                                           value="<%= (typeof profile !== 'undefined' && profile) ? profile.email : (typeof user !== 'undefined' && user) ? user.email : '' %>"
                                           readonly>
                                </div>
                                <div class="form-group sa-field">
                                    <label class="sa-label" for="phone">Numéro de téléphone</label>
                                    <input type="tel" class="sa-input"
                                           id="phone"
                                           placeholder="Entrez votre numéro"
                                           value="<%= (typeof profile !== 'undefined' && profile) ? profile.phone : '' %>">
                                </div>
                                <div class="form-group sa-field">
                                    <label class="sa-label" for="user-class">Niveau scolaire</label>
                                    <select class="sa-select" id="user-class" disabled aria-describedby="school-locked-hint">
                                        <option value="">Choisissez le niveau</option>
                                        <option value="1ere"  <%= (typeof profile !== 'undefined' && profile && profile.user_class === '1ere')  ? 'selected' : '' %>>1ère année</option>
                                        <option value="2eme"  <%= (typeof profile !== 'undefined' && profile && profile.user_class === '2eme')  ? 'selected' : '' %>>2ème année</option>
                                        <option value="3eme"  <%= (typeof profile !== 'undefined' && profile && profile.user_class === '3eme')  ? 'selected' : '' %>>3ème année</option>
                                        <option value="bac"   <%= (typeof profile !== 'undefined' && profile && profile.user_class === 'bac')   ? 'selected' : '' %>>Bac</option>
                                        <option value="other" <%= (typeof profile !== 'undefined' && profile && profile.user_class === 'other') ? 'selected' : '' %>>Autre</option>
                                    </select>
                                </div>
                                <div class="form-group sa-field">
                                    <label class="sa-label" for="user-branch">Branche</label>
                                    <select class="sa-select" id="user-branch" disabled aria-describedby="school-locked-hint">
                                        <option value="">Choisissez la branche</option>
                                        <option value="lettres"       <%= (typeof profile !== 'undefined' && profile && profile.user_branch === 'lettres')       ? 'selected' : '' %>>Lettres</option>
                                        <option value="mathematiques" <%= (typeof profile !== 'undefined' && profile && profile.user_branch === 'mathematiques') ? 'selected' : '' %>>Mathématiques</option>
                                        <option value="informatique"  <%= (typeof profile !== 'undefined' && profile && profile.user_branch === 'informatique')  ? 'selected' : '' %>>Informatique</option>
                                        <option value="sciences"      <%= (typeof profile !== 'undefined' && profile && profile.user_branch === 'sciences')      ? 'selected' : '' %>>Sciences</option>
                                        <option value="technique"     <%= (typeof profile !== 'undefined' && profile && profile.user_branch === 'technique')     ? 'selected' : '' %>>Technique</option>
                                        <option value="economie"      <%= (typeof profile !== 'undefined' && profile && profile.user_branch === 'economie')      ? 'selected' : '' %>>Économie</option>
                                        <option value="other"         <%= (typeof profile !== 'undefined' && profile && profile.user_branch === 'other')         ? 'selected' : '' %>>Autre</option>
                                    </select>
                                </div>
                                <p class="form-hint sa-hint tw-mb-5 tw-flex tw-items-center tw-gap-2" id="school-locked-hint"><i class="fas fa-lock tw-text-xs" aria-hidden="true"></i>Pour changer de niveau ou de branche, contacte l'équipe Synta.</p>
                                <button type="button" class="save-btn sa-btn sa-btn--primary tw-w-full sm:tw-w-auto sm:tw-px-6" onclick="saveProfile()">Enregistrer les modifications</button>
                            </div>
                        </div>

                    </div>

                    <div class="profile-sidebar tw-order-first min-[1025px]:tw-order-none">
                        <!-- Profile Picture -->
                        <div class="profile-picture-section sa-card tw-flex tw-justify-center tw-p-6">
                            <div class="profile-picture tw-m-0 tw-flex tw-h-24 tw-w-24 tw-cursor-default tw-items-center tw-justify-center tw-rounded-full tw-bg-brand-500 tw-bg-none tw-text-[2.5rem] tw-font-bold tw-text-white tw-shadow-none hover:tw-transform-none hover:tw-shadow-none" id="profile-picture" aria-hidden="true">
                                <span id="profile-initial">
                                    <%= (typeof profile !== 'undefined' && profile) ? profile.initial : 'U' %>
                                </span>
                            </div>
                        </div>
                    </div>
                    </div>
                </div>
            </div>
        </section>
    </div>

    <!-- Scripts -->
    <script src="/js/authentication.js"></script>
    <script src="/js/user.js?v=20261125-emphasis"></script>
    <script src="/js/profile.js"></script>
<script src="/js/email-verification-reminder.js?v=1" defer></script>
</body>
</html>
