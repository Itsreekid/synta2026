<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <%- include('../../partials/head', { title: 'تواصل معنا', css: 'contact' }) %>
</head>
<body>
    <div id="global-hydration-overlay"><div class="spinner"></div></div>
    <%- include('../../partials/header') %>

    <div class="content-wrapper">
        <%- include('../../partials/sidebar', { active: 'contact' }) %>

        <section id="main-section" class="main-section">
            <div class="contact-container">
                <div class="contact-header">
                    <h1>📞 تواصل معنا</h1>
                    <p>نحن هنا لمساعدتك في أي وقت</p>
                </div>
                <form class="contact-form" id="contact-form">
                    <div class="form-group">
                        <label for="name">الاسم الكامل</label>
                        <input type="text" id="name" required>
                    </div>
                    <div class="form-group">
                        <label for="email">البريد الإلكتروني</label>
                        <input type="email" id="email" required>
                    </div>
                    <div class="form-group">
                        <label for="message">رسالتك</label>
                        <textarea id="message" rows="5" required></textarea>
                    </div>
                    <button type="submit" class="contact-btn">إرسال</button>
                </form>
                <div class="contact-info">
                    <div><strong>البريد:</strong> synta.academy@gmail.com</div>
                    <div><strong>الهاتف:</strong> +216 99 999 999</div>
                    <div class="social-links">
                        <a href="#"><span>فيسبوك</span></a>
                        <a href="#"><span>انستغرام</span></a>
                        <a href="#"><span>تيك توك</span></a>
                    </div>
                </div>
            </div>
        </section>
    </div>

    <!-- Scripts -->
    <script src="/js/authentication.js"></script>
    <script src="/js/user.js"></script>
    <script src="/js/contact.js"></script>
</body>
</html>
