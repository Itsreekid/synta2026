<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Synta Academy - تأكيد البريد الإلكتروني</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Tajawal:wght@400;500;700;900&display=swap" rel="stylesheet">
    <link rel="icon" href="/source/logoweb.png" type="image/x-icon">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <style>
        :root {
            --primary: #013047;
            --secondary: #F6851F;
            --success: #10b981;
            --error: #ef4444;
            --bg: #f8fafc;
            --surface: #ffffff;
            --text-main: #1e293b;
            --text-muted: #64748b;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            font-family: 'Tajawal', sans-serif;
            background-color: var(--bg);
            color: var(--text-main);
            display: flex;
            align-items: center;
            justify-content: center;
            min-height: 100vh;
        }

        .verify-card {
            background: var(--surface);
            padding: 3rem 2rem;
            border-radius: 20px;
            box-shadow: 0 10px 40px rgba(1, 48, 71, 0.08);
            text-align: center;
            max-width: 480px;
            width: 90%;
            border-top: 6px solid var(--primary);
            position: relative;
            overflow: hidden;
        }

        .verify-card.success {
            border-top-color: var(--success);
        }

        .verify-card.error {
            border-top-color: var(--error);
        }

        .icon-wrap {
            width: 80px;
            height: 80px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 1.5rem;
            font-size: 2.5rem;
        }

        .success .icon-wrap {
            background: rgba(16, 185, 129, 0.1);
            color: var(--success);
        }

        .error .icon-wrap {
            background: rgba(239, 68, 68, 0.1);
            color: var(--error);
        }

        h1 {
            font-size: 1.8rem;
            font-weight: 800;
            margin-bottom: 1rem;
            color: var(--primary);
        }

        p {
            font-size: 1.1rem;
            color: var(--text-muted);
            line-height: 1.6;
            margin-bottom: 2rem;
        }

        .btn-action {
            display: inline-block;
            background: linear-gradient(135deg, var(--secondary) 0%, #e0720e 100%);
            color: white;
            text-decoration: none;
            padding: 1rem 2.5rem;
            border-radius: 12px;
            font-weight: 700;
            font-size: 1.1rem;
            transition: all 0.2s ease;
            box-shadow: 0 4px 15px rgba(246, 133, 31, 0.3);
        }

        .btn-action:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 25px rgba(246, 133, 31, 0.4);
        }

        .logo {
            width: 120px;
            margin-bottom: 2rem;
            opacity: 0.9;
        }
    </style>
</head>
<body>
    <div class="verify-card <%= status %>">
        <img src="/source/logo.png" alt="Synta Academy" class="logo">
        
        <div class="icon-wrap">
            <% if (status === 'success') { %>
                <i class="fas fa-check"></i>
            <% } else { %>
                <i class="fas fa-times"></i>
            <% } %>
        </div>

        <h1><%= status === 'success' ? 'نجاح!' : 'حدث خطأ' %></h1>
        <p><%= message %></p>

        <a href="<%= status === 'success' ? '/dashboard' : '/login' %>" class="btn-action">
            <%= status === 'success' ? 'المتابعة إلى لوحة التحكم' : 'العودة لتسجيل الدخول' %>
        </a>
    </div>
</body>
</html>
