<!DOCTYPE html>
<html lang="fr" dir="ltr">
<head><%- include('../../partials/auth-head', { title: 'Confirmation de ton e-mail' }) %></head>
<body class="auth-entry">
    <div class="auth-layout">
        <%- include('../../partials/auth-story') %>
        <main class="auth-main">
            <header class="auth-topbar"><a class="mobile-brand brand" href="/"><img class="brand-logo" src="/source/logo.webp" alt="Synta Academy" width="94" height="87"></a><a class="back-home" href="/">↖ Retour à l’accueil</a></header>
            <div class="auth-card status-panel">
                <div class="status-icon" aria-hidden="true"><%= status === 'success' ? '✓' : '✉' %></div>
                <span class="eyebrow"><%= status === 'success' ? 'Tout est prêt' : 'Confirmation de ton compte' %></span>
                <h1><%= status === 'success' ? 'Bienvenue chez Synta.' : 'On vérifie ce lien ?' %></h1>
                <p><%= message %></p>
                <% if (status !== 'success') { %><p class="field-hint">Connecte-toi avec ton e-mail pour demander un nouveau lien de confirmation.</p><% } %>
                <a class="button button-primary" href="/login">Aller à la connexion <span aria-hidden="true">→</span></a>
                <p class="form-switch"><a href="mailto:contact@syntaacademy.tn">Contacter l’équipe Synta</a></p>
            </div>
        </main>
    </div>
</body>
</html>
