<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
    <title>Synta Academy - تأكيد البريد الإلكتروني</title>
    <meta name="description" content="تأكيد البريد الإلكتروني لحسابك في Synta Academy">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Tajawal:wght@400;500;700&display=swap" rel="stylesheet">
    <link rel="icon" href="/source/logoweb.png" type="image/x-icon">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <link rel="stylesheet" href="/css/auth.css?v=5">
</head>
<body class="auth-page auth-page--verify">
<%
    const isSuccess = (typeof status !== 'undefined' && status === 'success');
    const msg = (typeof message !== 'undefined' && message) ? message : '';
%>
    <section class="auth-section">
        <div class="container">
            <div class="auth-container">
                <div class="auth-image" aria-hidden="true">
                    <div class="dynamic-auth-bg">
                        <div class="bubble bubble-1"></div>
                        <div class="bubble bubble-2"></div>
                        <div class="bubble bubble-3"></div>
                        <div class="bubble bubble-4"></div>
                        <div class="bubble bubble-5"></div>
                        <div class="streak streak-1"></div>
                        <div class="streak streak-2"></div>
                        <div class="streak streak-3"></div>
                        <div class="streak streak-4"></div>
                        <div class="streak streak-5"></div>
                        <div class="streak streak-6"></div>
                        <div class="streak streak-7"></div>
                        <div class="streak streak-8"></div>
                        <div class="rocket-glow"></div>
                        <div class="rocket-container">
                            <img src="/source/rocket.svg" alt="" class="rocket-svg">
                        </div>
                        <div class="logo-bubble-wrapper">
                            <img src="/source/logo.png" alt="Synta Academy" class="logo-bubble">
                        </div>
                    </div>
                </div>

                <div class="auth-form auth-form--status auth-form--centered">
                    <div class="auth-brand-mobile">
                        <img src="/source/logo.png" alt="Synta Academy">
                    </div>
                    <div class="auth-status-card">
                        <div class="auth-status-icon <%= isSuccess ? 'success' : 'warn' %>">
                            <i class="fas <%= isSuccess ? 'fa-check-circle' : 'fa-times-circle' %>" aria-hidden="true"></i>
                        </div>
                        <h2><%= isSuccess ? 'تم التفعيل!' : 'تعذر تأكيد البريد' %></h2>
                        <p class="auth-status-hint"><%= msg %></p>

                        <% if (isSuccess) { %>
                            <a href="/login" class="btn primary-btn btn-block" style="text-decoration:none;">تسجيل الدخول الآن</a>
                        <% } else { %>
                            <a href="/login" class="btn primary-btn btn-block" style="text-decoration:none;">العودة لتسجيل الدخول</a>
                            <p class="auth-status-hint" style="margin-top:1rem;margin-bottom:0;">
                                يمكنك طلب رابط تفعيل جديد عند محاولة تسجيل الدخول.
                            </p>
                        <% } %>
                    </div>
                </div>
            </div>
        </div>
    </section>
</body>
</html>
