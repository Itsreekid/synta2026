<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Synta Academy - تأكيد البريد الإلكتروني</title>
    <meta name="description" content="تأكيد البريد الإلكتروني لحسابك في Synta Academy">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Tajawal:wght@400;500;700&display=swap" rel="stylesheet">
    <link rel="icon" href="/source/logoweb.png" type="image/x-icon">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <link rel="stylesheet" href="/css/auth.css">
    <style>
        .verify-icon { font-size: 3.5rem; margin-bottom: 1rem; animation: verifyPop .5s ease-out; }
        .verify-icon.success { color: #22c55e; }
        .verify-icon.error   { color: #ef4444; }
        @keyframes verifyPop { 0% { transform: scale(.4); opacity: 0; } 80% { transform: scale(1.1); } 100% { transform: scale(1); opacity: 1; } }
    </style>
</head>
<body>
<%
    const isSuccess = (typeof status !== 'undefined' && status === 'success');
    const msg = (typeof message !== 'undefined' && message) ? message : '';
%>
    <section class="auth-section">
        <div class="container">
            <div class="auth-container">
                <div class="auth-image">
                    <div class="dynamic-auth-bg">
                        <div class="bubble bubble-1"></div>
                        <div class="bubble bubble-2"></div>
                        <div class="bubble bubble-3"></div>
                        <div class="bubble bubble-4"></div>
                        <div class="bubble bubble-5"></div>
                        <div class="streak streak-1"></div>
                        <div class="streak streak-2"></div>
                        <div class="streak streak-3"></div>
                        <div class="streak streak-4"></div>
                        <div class="streak streak-5"></div>
                        <div class="streak streak-6"></div>
                        <div class="streak streak-7"></div>
                        <div class="streak streak-8"></div>
                        <div class="rocket-glow"></div>
                        <div class="rocket-container">
                            <img src="/source/rocket.svg" alt="Rocket" class="rocket-svg">
                        </div>
                        <div class="logo-bubble-wrapper">
                            <img src="/source/logo.png" alt="Synta Academy" class="logo-bubble">
                        </div>
                    </div>
                </div>

                <div class="auth-form auth-form--centered" style="text-align: center;">
                    <div class="verify-icon <%= isSuccess ? 'success' : 'error' %>">
                        <i class="fas <%= isSuccess ? 'fa-check-circle' : 'fa-times-circle' %>"></i>
                    </div>
                    <h1 style="color: #013047; font-size: 1.6rem; margin-bottom: 1rem;">
                        <%= isSuccess ? 'تم التفعيل!' : 'تعذر تأكيد البريد' %>
                    </h1>
                    <p style="color: #64748b; font-size: 1.05rem; line-height: 1.6; margin-bottom: 2rem;">
                        <%= msg %>
                    </p>

                    <% if (isSuccess) { %>
                        <a href="/login" id="verifyGoLoginBtn" class="btn primary-btn btn-block" style="text-decoration: none; display: block;">
                            تسجيل الدخول الآن
                        </a>
                    <% } else { %>
                        <a href="/login" id="verifyBackLoginBtn" class="btn primary-btn btn-block" style="text-decoration: none; display: block;">
                            العودة لتسجيل الدخول
                        </a>
                        <p style="color: #64748b; font-size: 0.9rem; margin-top: 1rem;">
                            يمكنك طلب رابط تفعيل جديد عند محاولة تسجيل الدخول.
                        </p>
                    <% } %>
                </div>
            </div>
        </div>
    </section>
</body>
</html>
