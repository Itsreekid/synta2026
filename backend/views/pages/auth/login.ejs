<!DOCTYPE html>
<html lang="fr" dir="ltr">
<head>
    <%- include('../../partials/auth-head', { title: 'Connexion' }) %>
    <% if (googleClientId) { %><script src="https://accounts.google.com/gsi/client?hl=fr" async></script><% } %>
</head>
<body class="auth-entry">
    <a class="skip-link" href="#auth-content">Aller à la connexion</a>
    <div class="auth-layout">
        <%- include('../../partials/auth-story') %>
        <main class="auth-main" id="auth-content">
            <header class="auth-topbar"><a class="mobile-brand brand" href="/"><img class="brand-logo" src="/source/logo.webp" alt="Synta Academy" width="94" height="87"></a><a class="back-home" href="/">↖ Retour à l’accueil</a><span class="topbar-note">Ton espace d’apprentissage</span></header>
            <div class="auth-card">
                <nav class="auth-tabs" aria-label="Accès à ton compte"><a href="/login" aria-current="page">Connexion</a><a href="/register" data-auth-link>Inscription</a></nav>
                <div id="authMessageMount" aria-live="polite" aria-atomic="true"></div>
                <section id="loginFormPanel">
                    <div class="form-intro"><span class="eyebrow">Heureux de te retrouver</span><h1>On reprend ?</h1><p>Connecte-toi et continue à faire des progrès.</p></div>
                    <div class="google-signin-container"><div id="googleSignInBtn" data-client-id="<%= googleClientId || '' %>" data-button-text="continue_with"></div></div>
                    <div class="divider"><span>ou avec ton e-mail</span></div>
                    <form id="loginForm" method="post" novalidate>
                        <div class="form-group"><label for="email">Adresse e-mail</label><input type="email" id="email" name="email" autocomplete="username" inputmode="email" autocapitalize="none" spellcheck="false" placeholder="toi@exemple.com" required aria-describedby="email-error"><span class="field-error" id="email-error"></span></div>
                        <div class="form-group"><div class="label-row"><label for="password">Mot de passe</label><a href="/password-reset">Mot de passe oublié ?</a></div><div class="password-input"><input type="password" id="password" name="password" autocomplete="current-password" placeholder="Ton mot de passe" required aria-describedby="password-error"><button class="password-toggle" type="button" aria-label="Afficher le mot de passe" aria-pressed="false">Afficher</button></div><span class="field-error" id="password-error"></span></div>
                        <button type="submit" class="button button-primary" id="loginSubmitBtn" data-idle="Me connecter">Me connecter <span aria-hidden="true">↗</span></button>
                    </form>
                    <p class="form-switch">Tu découvres Synta ? <a href="/register" data-auth-link>Créer mon compte</a></p>
                </section>
                <section id="unverifiedState" class="status-panel" hidden tabindex="-1">
                    <div class="status-icon" aria-hidden="true">✉</div><h1>Un dernier clic.</h1><p>Confirme ton adresse avec le lien envoyé à <strong id="unverifiedEmailDisplay"></strong>.</p><p class="field-hint">Pense à regarder dans les courriers indésirables.</p>
                    <button type="button" class="button button-primary" id="resendVerificationBtnLogin">Renvoyer le lien</button><p id="resendMessageLogin" class="inline-status" role="status"></p><button type="button" class="text-button" data-return-login>Revenir à la connexion</button>
                </section>
                <noscript><p class="message error">Active JavaScript pour te connecter à ton compte.</p></noscript>
            </div>
            <footer class="auth-footer"><span>Un peu de curiosité. Beaucoup de possibilités.</span><a href="mailto:contact@syntaacademy.tn">Besoin d’aide ?</a></footer>
        </main>
    </div>
    <script src="/js/authentication.js?v=3" defer></script>
    <script src="/js/auth-entry.js?v=1" defer></script>
    <script src="/js/google-auth.js?v=6" defer></script>
</body>
</html>
