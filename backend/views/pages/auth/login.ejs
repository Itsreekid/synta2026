<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
    <title>Synta Academy - تسجيل الدخول</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Tajawal:wght@400;500;700&display=swap" rel="stylesheet">
    <link rel="icon" href="/source/logoweb.png" type="image/x-icon">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <link rel="stylesheet" href="/css/auth.css?v=6">
    <script id="__SYNTA_CONFIG__">
        window.__SYNTA_CONFIG__ = {
            supabaseUrl: "<%- (typeof syntaConfig !== 'undefined' && syntaConfig.url) ? syntaConfig.url : '' %>",
            supabaseAnonKey: "<%- (typeof syntaConfig !== 'undefined' && syntaConfig.anonKey) ? syntaConfig.anonKey : '' %>"
        };
    </script>
    <script src="https://unpkg.com/@supabase/supabase-js@2"></script>
    <script src="https://accounts.google.com/gsi/client" async defer></script>
</head>
<body class="auth-page auth-page--login">
    <section class="auth-section">
        <div class="container">
            <div class="auth-container">
                <div class="auth-image" aria-hidden="true">
                    <div class="dynamic-auth-bg">
                        <div class="bubble bubble-1"></div>
                        <div class="bubble bubble-2"></div>
                        <div class="bubble bubble-3"></div>
                        <div class="bubble bubble-4"></div>
                        <div class="bubble bubble-5"></div>
                        <div class="streak streak-1"></div>
                        <div class="streak streak-2"></div>
                        <div class="streak streak-3"></div>
                        <div class="streak streak-4"></div>
                        <div class="streak streak-5"></div>
                        <div class="streak streak-6"></div>
                        <div class="streak streak-7"></div>
                        <div class="streak streak-8"></div>
                        <div class="rocket-glow"></div>
                        <div class="rocket-container">
                            <img src="/source/rocket.svg" alt="" class="rocket-svg">
                        </div>
                        <div class="logo-bubble-wrapper">
                            <img src="/source/logo.png" alt="Synta Academy" class="logo-bubble">
                        </div>
                    </div>
                </div>

                <div class="auth-form auth-form--centered" id="loginFormPanel">
                    <div class="auth-brand-mobile">
                        <img src="/source/logo.png" alt="Synta Academy">
                    </div>
                    <h2>تسجيل الدخول</h2>
                    <p>ليس لديك حساب؟ <a href="/register">إنشاء حساب جديد</a></p>
                    <div id="authMessageMount" class="auth-message-mount" aria-live="polite"></div>

                    <form id="loginForm" method="POST" novalidate>
                        <div class="form-group">
                            <label for="email">البريد الإلكتروني</label>
                            <input type="email" id="email" name="email" autocomplete="email" inputmode="email" required>
                        </div>
                        <div class="form-group">
                            <label for="password">كلمة المرور</label>
                            <div class="password-input-wrapper">
                                <input type="password" id="password" name="password" autocomplete="current-password" required>
                                <i class="fas fa-eye toggle-password" id="togglePassword" role="button" tabindex="0" aria-label="إظهار كلمة المرور"></i>
                            </div>
                        </div>
                        <div class="form-group form-group--inline">
                            <a href="/password-reset" class="forgot-password">نسيت كلمة المرور؟</a>
                        </div>
                        <button type="submit" id="loginSubmitBtn" class="btn primary-btn btn-block">تسجيل الدخول</button>
                    </form>

                    <div class="social-divider"><span>أو</span></div>

                    <div id="google-signin-container" class="google-signin-container">
                        <div id="googleSignInBtn" data-client-id="<%= googleClientId || '' %>" data-button-text="signin_with"></div>
                    </div>
                </div>

                <div id="unverifiedState" class="auth-form auth-form--status auth-form--centered" hidden>
                    <div class="auth-status-card">
                        <div class="auth-status-icon warn"><i class="fas fa-exclamation-circle"></i></div>
                        <h2>حساب غير مفعل</h2>
                        <p>
                            لقد أرسلنا رابط التفعيل إلى بريدك الإلكتروني:<br>
                            <strong id="unverifiedEmailDisplay" class="auth-email-highlight"></strong>
                        </p>
                        <p class="auth-status-hint">فعّل حسابك من الرابط في البريد، ثم عد لتسجيل الدخول. تحقّق أيضاً من Spam.</p>

                        <button type="button" id="resendVerificationBtnLogin" class="btn secondary-outline-btn btn-block">
                            <i class="fas fa-redo" aria-hidden="true"></i>
                            إعادة إرسال بريد التفعيل
                        </button>
                        <p id="resendMessageLogin" class="auth-inline-feedback" hidden></p>

                        <a href="/login" class="auth-back-link">العودة لتسجيل الدخول</a>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <script src="/js/authentication.js"></script>
    <script src="/js/auth.js?v=5"></script>
    <script src="/js/google-auth.js?v=5"></script>
</body>
</html>
