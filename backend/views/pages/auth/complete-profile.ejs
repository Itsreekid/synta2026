<!DOCTYPE html>
<html lang="fr" dir="ltr">
<head><%- include('../../partials/auth-head', { title: 'Ton parcours' }) %></head>
<body class="auth-entry">
    <a class="skip-link" href="#auth-content">Aller à mon profil</a>
    <div class="auth-layout">
        <%- include('../../partials/auth-story') %>
        <main class="auth-main" id="auth-content">
            <header class="auth-topbar"><a class="mobile-brand brand" href="/"><img class="brand-logo" src="/source/logo.webp" alt="Synta Academy" width="94" height="87"></a><a class="back-home" href="/">↖ Retour à l’accueil</a><span class="topbar-note">Bienvenue sur Synta</span></header>
            <div class="auth-card">
                <div class="form-intro"><span class="eyebrow">Ton compte Google est connecté</span><h1>Un profil qui<br>te ressemble.</h1><p>Précise ton parcours pour retrouver les formations adaptées à ton niveau.</p></div>
                <p class="account-badge"><span class="status-dot"></span><%= user.email %></p>
                <div id="authMessageMount" aria-live="polite" aria-atomic="true"></div>
                <form id="completeProfileForm" method="post" novalidate>
                    <%- include('../../partials/auth-profile-fields') %>
                    <button type="submit" class="button button-primary" data-idle="Commencer à apprendre">Commencer à apprendre <span aria-hidden="true">↗</span></button>
                    <p class="field-hint account-note">Tu pourras modifier ces informations dans ton profil.</p>
                </form>
                <noscript><p class="message error">Active JavaScript pour compléter ton profil.</p></noscript>
            </div>
            <footer class="auth-footer"><span>Un peu de curiosité. Beaucoup de possibilités.</span><a href="mailto:contact@syntaacademy.tn">Besoin d’aide ?</a></footer>
        </main>
    </div>
    <script src="/js/auth-entry.js?v=1" defer></script>
</body>
</html>
