<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Synta Academy - إنشاء حساب</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Tajawal:wght@400;500;700&display=swap" rel="stylesheet">
    <link rel="icon" href="/source/logoweb.png" type="image/x-icon">
    <link rel="stylesheet" href="/css/auth.css">
    <script id="__SYNTA_CONFIG__">
        window.__SYNTA_CONFIG__ = {
            supabaseUrl: "<%- (typeof syntaConfig !== 'undefined' && syntaConfig.url) ? syntaConfig.url : '' %>",
            supabaseAnonKey: "<%- (typeof syntaConfig !== 'undefined' && syntaConfig.anonKey) ? syntaConfig.anonKey : '' %>"
        };
    </script>
    <script src="https://unpkg.com/@supabase/supabase-js@2"></script>
    <!-- Google Identity Services SDK -->
    <script src="https://accounts.google.com/gsi/client" async defer></script>
</head>
<body>
    <section class="auth-section">
        <div class="container">
            <div class="auth-container">
                <div class="auth-image theme-primary">
                    <div class="dynamic-auth-bg">
                        <div class="bubble bubble-1"></div>
                        <div class="bubble bubble-2"></div>
                        <div class="bubble bubble-3"></div>
                        <div class="bubble bubble-4"></div>
                        <div class="bubble bubble-5"></div>
                        <div class="streak streak-1"></div>
                        <div class="streak streak-2"></div>
                        <div class="streak streak-3"></div>
                        <div class="streak streak-4"></div>
                        <div class="streak streak-5"></div>
                        <div class="streak streak-6"></div>
                        <div class="streak streak-7"></div>
                        <div class="streak streak-8"></div>
                        <div class="rocket-glow"></div>
                        <div class="rocket-container">
                            <img src="/source/rocket.svg" alt="Rocket" class="rocket-svg">
                        </div>
                        <div class="logo-bubble-wrapper">
                            <img src="/source/logo.png" alt="Synta Academy" class="logo-bubble">
                        </div>
                    </div>
                </div>
                <div class="auth-form">
                    <h2>إنشاء حساب جديد</h2>
                    <p>لديك حساب بالفعل؟ <a href="/login">تسجيل الدخول</a></p>

                    <form id="registerForm" method="POST">
                        <div class="form-row">
                            <div class="form-group">
                                <label for="fullName">الاسم الكامل</label>
                                <input type="text" id="fullName" name="fullName" required>
                            </div>
                            <div class="form-group">
                                <label for="email">البريد الإلكتروني</label>
                                <input type="email" id="email" name="email" required>
                            </div>
                        </div>
                        <div class="form-group">
                            <label for="phone">رقم الهاتف</label>
                            <input type="tel" id="phone" name="phone" required minlength="8" maxlength="8"
                                pattern="^[24579][0-9]{7}$"
                                title="يرجى إدخال رقم هاتف تونسي صحيح (8 أرقام تبدأ بـ 2، 4، 5، 7، أو 9)">
                            <span class="password-hint">رقم هاتف يجب أن يكون متكون من 8 أرقام</span>
                        </div>
                        <div class="form-row">
                            <div class="form-group">
                                <label for="userClass">المستوى الدراسي</label>
                                <select id="userClass" name="userClass" required>
                                    <option value="" disabled selected>اختر المستوى</option>
                                    <option value="1ere">1ère année</option>
                                    <option value="2eme">2ème année</option>
                                    <option value="3eme">3ème année</option>
                                    <option value="bac">Bac</option>
                                    <option value="other">أخرى</option>
                                </select>
                            </div>
                            <div class="form-group">
                                <label for="userBranch">الفرع</label>
                                <select id="userBranch" name="userBranch" required>
                                    <option value="" disabled selected>اختر الشعبة</option>
                                    <option value="lettres">شعبة الآداب</option>
                                    <option value="mathematiques">شعبة الرياضيات</option>
                                    <option value="informatique">شعبة العلوم الإعلامية</option>
                                    <option value="sciences">شعبة العلوم التجريبية</option>
                                    <option value="technique">شعبة العلوم التقنية</option>
                                    <option value="economie">شعبة الاقتصاد والتصرف</option>
                                    <option value="other">أخرى</option>
                                </select>
                            </div>
                        </div>
                        <div class="form-row">
                            <div class="form-group">
                                <label for="password">كلمة المرور</label>
                                <div class="password-input-wrapper">
                                    <input type="password" id="password" name="password" required>
                                </div>
                                <span class="password-hint">يجب أن تكون 6 أحرف على الأقل</span>
                            </div>
                            <div class="form-group">
                                <label for="confirmPassword">تأكيد كلمة المرور</label>
                                <div class="password-input-wrapper">
                                    <input type="password" id="confirmPassword" name="confirmPassword" required>
                                </div>
                            </div>
                        </div>
                        <div class="terms">
                            <input type="checkbox" id="terms" name="terms" required>
                            <label for="terms">أوافق على <a href="#">الشروط والأحكام</a></label>
                        </div>
                        <button type="submit" id="registerSubmitBtn" class="btn primary-btn btn-block">إنشاء الحساب</button>
                    </form>

                    <!-- Social login divider -->
                    <div class="social-divider">
                        <span>أو سجّل بسرعة مع</span>
                    </div>

                    <!-- Google Sign-In Button -->
                    <div id="google-signin-container" class="google-signin-container">
                        <button type="button" id="googleSignInBtn" class="btn google-btn btn-block">
                            <svg class="google-icon" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                                <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4"/>
                                <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/>
                                <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" fill="#FBBC05"/>
                                <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/>
                            </svg>
                            <span id="googleBtnText">إنشاء حساب بـ Google</span>
                            <span id="googleBtnSpinner" class="google-btn-spinner" style="display:none;"></span>
                        </button>
                        <p class="google-register-note">سيتم إنشاء حسابك تلقائياً باستخدام بريد Google الإلكتروني.</p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <script src="/js/authentication.js"></script>
    <script src="/js/auth.js"></script>
    <script src="/js/google-auth.js"></script>
</body>
</html>
