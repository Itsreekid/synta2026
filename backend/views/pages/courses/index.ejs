<!DOCTYPE html>
<html lang="fr" dir="ltr">
<head>
    <%- include('../../partials/head', { turboReload: true, title: 'Tous les Cours', css: 'courses',
        extraHead: '<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">' }) %>
    <link rel="stylesheet" href="/css/course-markdown.css?v=2">
</head>
<body>
    <div id="global-hydration-overlay"><div class="spinner"></div></div>
    <%- include('../../partials/header') %>

    <div class="content-wrapper">
        <%- include('../../partials/sidebar', { active: 'courses' }) %>

        <section id="main-section" class="main-section courses-page">
            <div class="courses-container">

                <!-- ══ MAIN BANNER ══ -->
                <header class="courses-banner">
                    <div class="courses-banner-text">
                        <h1>Explore nos cours et <span>progresse à ton rythme</span></h1>
                        <p>Des cours clairs et des vidéos courtes pour t'aider à réussir ton bac.</p>
                    </div>
                    <div class="courses-banner-mascot" aria-hidden="true">
                        <span class="mascot-bubble bubble-1"></span>
                        <span class="mascot-bubble bubble-2"></span>
                        <span class="mascot-bubble bubble-3"></span>
                        <img src="/source/Robot%20for%20web.webp" alt="" width="240" height="240">
                    </div>
                </header>

                <!-- ══ FILTERS ══ -->
                <div class="courses-toolbar">
                    <div class="search-bar">
                        <i class="fas fa-search" aria-hidden="true"></i>
                        <input type="search" id="search-courses" aria-label="Rechercher un cours" placeholder="Rechercher un cours…" autocomplete="off">
                    </div>
                    <div class="filter-chips" role="group" aria-label="Filtrer par catégorie">
                        <button class="chip active" type="button" data-category="" aria-pressed="true" onclick="applyCategoryFilter('')">Tous les cours</button>
                        <button class="chip" type="button" data-category="bac-info" aria-pressed="false" onclick="applyCategoryFilter('bac-info')">Bac Informatique</button>
                        <button class="chip" type="button" data-category="bac-math" aria-pressed="false" onclick="applyCategoryFilter('bac-math')">Bac Mathématiques</button>
                        <button class="chip" type="button" data-category="web-dev" aria-pressed="false" onclick="applyCategoryFilter('web-dev')">Développement Web</button>
                        <button class="chip" type="button" data-category="general" aria-pressed="false" onclick="applyCategoryFilter('general')">Général</button>
                    </div>
                </div>

                <!-- ══ RESUME LEARNING ══ -->
                <div id="resume-learning-section" hidden>
                    <!-- Active course will be injected here -->
                </div>

                <!-- ══ COURSE GRID ══ -->
                <div class="courses-list" id="courses-list" aria-live="polite">
                    <div class="loading" role="status">Chargement des cours…</div>
                    <noscript>Activez JavaScript pour afficher le catalogue des cours.</noscript>
                </div>
            </div>
        </section>
    </div>

    <!-- Scripts -->
    <script src="/js/authentication.js"></script>
    <script src="/js/user.js?v=20261124-notifications"></script>
    <script src="/js/api-client.js"></script>
    <script src="/js/course-image.js"></script>
    <script src="/js/course-markdown.js?v=2"></script>
    <script src="/js/courses.js?v=6"></script>
</body>
</html>
