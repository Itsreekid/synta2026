<!DOCTYPE html>
<html lang="fr" dir="ltr">
<head>
    <%- include('../../partials/head', { title: 'Détails du Cours', css: 'courses' }) %>
    <style>
        .course-details-container {
            max-width: 1400px;
            margin: 0 auto;
            width: 100%;
        }
        
        .back-link {
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            color: #667eea;
            text-decoration: none;
            font-weight: 600;
            margin-bottom: 1.5rem;
            transition: all 0.3s;
            font-size: 1rem;
        }
        
        .back-link:hover {
            gap: 0.75rem;
            color: #5a67d8;
        }
        
        .course-layout {
            display: grid;
            grid-template-columns: 1fr 380px;
            gap: 2rem;
            align-items: start;
        }
        
        .course-main {
            background: rgba(255, 255, 255, 0.98);
            border-radius: 24px;
            padding: 2.5rem;
            box-shadow: 0 10px 40px rgba(0,0,0,0.05);
            border: 1px solid rgba(226, 232, 240, 0.8);
        }
        
        .course-title-section h1 {
            font-size: 2.5rem;
            color: #1e293b;
            margin-bottom: 1.5rem;
            font-weight: 800;
            line-height: 1.2;
            background: linear-gradient(135deg, #1e293b 0%, #475569 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }
        
        .course-description-section {
            margin-bottom: 3rem;
        }
        
        .course-description-section h2 {
            font-size: 1.5rem;
            color: #334155;
            margin-bottom: 1rem;
            font-weight: 700;
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }
        
        .course-description-section h2::before {
            content: '';
            display: block;
            width: 4px;
            height: 20px;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            border-radius: 4px;
        }
        
        .course-description-section p {
            color: #64748b;
            line-height: 1.8;
            font-size: 1.05rem;
        }
        
        .modules-section {
            margin-top: 2rem;
        }
        
        .module-card {
            background: white;
            border-radius: 16px;
            margin-bottom: 1.5rem;
            overflow: hidden;
            border: 1px solid #f1f5f9;
            box-shadow: 0 4px 15px rgba(0,0,0,0.03);
            transition: all 0.3s ease;
        }
        
        .module-card:hover {
            box-shadow: 0 8px 25px rgba(102, 126, 234, 0.1);
            border-color: #e0e7ff;
        }
        
        .module-header {
            padding: 1.5rem;
            background: #fafafa;
            cursor: pointer;
            display: flex;
            justify-content: space-between;
            align-items: center;
            transition: all 0.3s ease;
        }
        
        .module-header:hover {
            background: #f1f5f9;
        }
        
        .module-header h3 {
            font-size: 1.15rem;
            color: #1e293b;
            font-weight: 700;
            margin: 0;
        }
        
        .module-toggle {
            font-size: 1.25rem;
            color: #64748b;
            transition: transform 0.4s cubic-bezier(0.4, 0, 0.2, 1);
            background: white;
            width: 32px;
            height: 32px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 50%;
            box-shadow: 0 2px 8px rgba(0,0,0,0.05);
        }
        
        .module-toggle.open {
            transform: rotate(180deg);
            background: #667eea;
            color: white;
        }
        
        .lessons-list {
            padding: 1rem;
            display: none;
            background: white;
        }
        
        .lessons-list.open {
            display: block;
            animation: fadeIn 0.4s ease;
        }
        
        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(-10px); }
            to { opacity: 1; transform: translateY(0); }
        }
        
        .lesson-item {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 1.25rem;
            background: white;
            border-radius: 12px;
            margin-bottom: 0.75rem;
            transition: all 0.2s ease;
            border: 1px solid #f1f5f9;
        }
        
        .lesson-item:last-child {
            margin-bottom: 0;
        }
        
        .lesson-item:hover {
            background: #f8fafc;
            transform: translateX(4px);
            border-color: #e2e8f0;
        }
        
        .lesson-item.locked {
            opacity: 0.7;
            background: #f8fafc;
        }
        
        .lesson-info {
            display: flex;
            gap: 1.25rem;
            align-items: center;
            flex: 1;
        }
        
        .lesson-icon {
            width: 40px;
            height: 40px;
            border-radius: 10px;
            background: #edf2ff;
            color: #667eea;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.25rem;
        }
        
        .lesson-item.locked .lesson-icon {
            background: #f1f5f9;
            color: #94a3b8;
        }
        
        .lesson-details {
            flex: 1;
        }
        
        .lesson-title {
            font-size: 1rem;
            color: #334155;
            font-weight: 600;
            margin-bottom: 0.25rem;
        }
        
        .lesson-duration {
            font-size: 0.85rem;
            color: #94a3b8;
            display: flex;
            align-items: center;
            gap: 0.25rem;
        }
        
        .lesson-status {
            display: flex;
            align-items: center;
            gap: 0.75rem;
        }
        
        .lock-icon {
            font-size: 1.2rem;
            color: #94a3b8;
        }
        
        .play-icon {
            font-size: 1.2rem;
            color: #667eea;
            cursor: pointer;
            width: 36px;
            height: 36px;
            display: flex;
            align-items: center;
            justify-content: center;
            background: white;
            border-radius: 50%;
            box-shadow: 0 2px 8px rgba(0,0,0,0.1);
            transition: all 0.2s;
        }
        
        .play-icon:hover {
            background: #667eea;
            color: white;
            transform: scale(1.1);
        }
        
        /* Premium Sidebar */
        .course-sidebar {
            background: white;
            border-radius: 24px;
            padding: 2rem;
            box-shadow: 0 10px 40px rgba(0,0,0,0.06);
            border: 1px solid rgba(226, 232, 240, 0.8);
            position: sticky;
            top: 100px;
        }
        
        .course-thumbnail-sidebar {
            width: 100%;
            height: 220px;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            border-radius: 16px;
            margin-bottom: 2rem;
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-size: 2rem;
            font-weight: 700;
            overflow: hidden;
            box-shadow: 0 8px 25px rgba(102, 126, 234, 0.25);
        }
        
        .course-thumbnail-sidebar img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform 0.5s ease;
        }
        
        .course-thumbnail-sidebar:hover img {
            transform: scale(1.05);
        }
        
        .price-section {
            text-align: center;
            margin-bottom: 2rem;
            padding-bottom: 1.5rem;
            border-bottom: 2px dashed #f1f5f9;
        }
        
        .original-price {
            font-size: 1.15rem;
            color: #94a3b8;
            text-decoration: line-through;
            margin-bottom: 0.5rem;
        }
        
        .current-price {
            font-size: 3rem;
            font-weight: 800;
            color: #1e293b;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 0.5rem;
            line-height: 1;
        }
        
        .current-price .dt-currency-icon-large {
            width: 24px;
            height: 24px;
            object-fit: contain;
            filter: brightness(0) saturate(100%) invert(11%) sepia(15%) saturate(1291%) hue-rotate(178deg) brightness(95%) contrast(95%);
        }
        
        .course-stats {
            margin-bottom: 2rem;
        }
        
        .stat-item {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 1rem 0;
            border-bottom: 1px solid #f1f5f9;
        }
        
        .stat-item:last-child {
            border-bottom: none;
        }
        
        .stat-label {
            display: flex;
            align-items: center;
            gap: 0.75rem;
            color: #475569;
            font-size: 1rem;
            font-weight: 500;
        }
        
        .stat-value {
            color: #1e293b;
            font-weight: 700;
            font-size: 1rem;
        }
        
        .buy-button {
            width: 100%;
            background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%);
            color: white;
            border: none;
            border-radius: 14px;
            padding: 1.25rem 2rem;
            font-family: 'Inter', sans-serif;
            font-weight: 800;
            font-size: 1.15rem;
            cursor: pointer;
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            box-shadow: 0 8px 25px rgba(245, 158, 11, 0.3);
            margin-bottom: 1rem;
        }
        
        .buy-button:hover {
            transform: translateY(-4px);
            box-shadow: 0 12px 35px rgba(245, 158, 11, 0.4);
        }
        
        .lifetime-access {
            text-align: center;
            color: #64748b;
            font-size: 0.95rem;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 0.5rem;
        }
        
        @media (max-width: 1024px) {
            .course-layout {
                grid-template-columns: 1fr;
            }
            .course-sidebar {
                position: static;
                order: -1;
            }
        }
        
        @media (max-width: 768px) {
            .course-main, .course-sidebar {
                padding: 1.5rem;
            }
            .course-title-section h1 {
                font-size: 1.8rem;
            }
        }
    </style>
</head>
<body>
    <%- include('../../partials/header') %>

    <div class="content-wrapper">
        <%- include('../../partials/sidebar', { active: 'courses' }) %>

        <section id="main-section" class="main-section">
            <div class="course-details-container">
        <a href="/app/courses" class="back-link">← Retour aux cours</a>
        
        <div class="course-layout">
            <!-- Main Content -->
            <div class="course-main">
                <div class="course-title-section">
                    <h1 id="course-title">Chargement...</h1>
                </div>
                
                <div class="course-description-section">
                    <h2>Course Description</h2>
                    <p id="course-description">Chargement de la description...</p>
                </div>
                
                <div class="modules-section" id="modules-container">
                    <!-- Modules and lessons will be loaded here -->
                </div>
            </div>
            
            <!-- Sidebar -->
            <div class="course-sidebar">
                <div class="course-thumbnail-sidebar" id="course-thumbnail">
                    <!-- Thumbnail will be loaded here -->
                </div>
                
                <div class="price-section">
                    <div class="original-price" id="original-price" style="display: none;"></div>
                    <div class="current-price" id="current-price">Chargement...</div>
                </div>
                
                <div class="course-stats">
                    <div class="stat-item">
                        <span class="stat-label">📚 Lessons</span>
                        <span class="stat-value" id="lessons-count">0</span>
                    </div>
                    <div class="stat-item">
                        <span class="stat-label">🌐 Language</span>
                        <span class="stat-value" id="course-language">Français</span>
                    </div>
                </div>
                
                <button class="buy-button" id="buy-button">Acheter maintenant</button>
                <div class="lifetime-access">Accès à vie</div>
            </div>
            </div>
        </section>
    </div>
    
    <!-- Include API client -->
    <script src="/js/authentication.js"></script>
    <script src="/js/api-client.js"></script>
    <script src="/js/course-details.js"></script>
</body>
</html>
