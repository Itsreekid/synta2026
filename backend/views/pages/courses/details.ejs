<!DOCTYPE html>
<html lang="fr" dir="ltr">
<head>
    <%- include('../../partials/head', { turboReload: true, title: 'Détails du Cours', css: 'course-details',
        extraHead: '<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">'
    }) %>
    <link rel="stylesheet" href="/css/course-markdown.css?v=2">
<link rel="stylesheet" href="/css/learning-player.css?v=2">
<link rel="stylesheet" href="/vendor/videojs/10.6.0/global.css">
</head>
<body>
    <%- include('../../partials/header') %>

    <div class="content-wrapper">
        <%- include('../../partials/sidebar', { active: 'courses' }) %>

        <section id="main-section" class="main-section course-details-page">
            <div class="course-details-container">
                <a href="/app/courses" class="back-link">
                    <i class="fas fa-arrow-left" aria-hidden="true"></i> <span>Retour aux cours</span>
                </a>

                <div class="course-layout">
                    <!-- Main Content -->
                    <div class="course-main">

                        <!-- Course card (moved to the side column on wide screens) -->
                        <div class="course-hero">
                            <div class="course-thumbnail-hero" id="course-thumbnail-hero"></div>
                            <div class="course-title-wrapper">
                                <span class="course-badge" id="course-category-badge" hidden></span>
                                <h1 id="course-title">Chargement...</h1>
                                <div class="course-subtitle course-markdown" id="course-description" dir="auto">Chargement de la description...</div>
                                <div class="course-stats-grid">
                                    <div class="stat-box is-lessons">
                                        <div class="stat-icon"><i class="fas fa-play" aria-hidden="true"></i></div>
                                        <div class="stat-text"><strong id="lessons-count">0</strong><span>Leçons</span></div>
                                    </div>
                                    <div class="stat-box is-quiz">
                                        <div class="stat-icon"><i class="fas fa-bolt" aria-hidden="true"></i></div>
                                        <div class="stat-text"><strong id="quizzes-count">0</strong><span>Quiz</span></div>
                                    </div>
                                    <div class="stat-box is-replays">
                                        <div class="stat-icon"><i class="fas fa-video" aria-hidden="true"></i></div>
                                        <div class="stat-text"><strong id="lives-count">0</strong><span>Replays</span></div>
                                    </div>
                                </div>

                                <!-- Progress Area -->
                                <div class="course-progress" id="progress-container" style="display: none;">
                                    <div class="course-progress-row">
                                        <div>
                                            <div class="course-progress-label">Progression du cours</div>
                                            <div class="course-progress-count"><i class="fas fa-check-circle" aria-hidden="true"></i> <span id="progress-completed-text">0 / 0 leçons</span></div>
                                        </div>
                                        <div id="progress-percentage-text">0%</div>
                                    </div>
                                    <div class="course-progress-track"><div id="progress-bar-fill"></div></div>
                                </div>

                                <a href="/app/offers" class="buy-button" id="buy-button" hidden><i class="fas fa-unlock" aria-hidden="true"></i> Découvrir les offres</a>
                            </div>
                        </div>

                        <nav class="course-content-tabs" role="tablist" aria-label="Contenu du cours" data-viewer="<%= user.id %>">
                            <button class="course-content-tab is-active" id="chapters-tab" type="button" role="tab" aria-selected="true" aria-controls="chapters-panel" data-course-tab="chapters">
                                <i class="fas fa-book-open" aria-hidden="true"></i> Chapitres
                                <span class="course-unread-dot" role="img" aria-label="Chapitres mis à jour" hidden></span>
                            </button>
                            <button class="course-content-tab" id="live-tab" type="button" role="tab" aria-selected="false" tabindex="-1" aria-controls="live-panel" data-course-tab="live">
                                <i class="fas fa-video" aria-hidden="true"></i> Replays
                                <span class="course-live-tab-count" id="live-tab-count">0</span>
                                <span class="course-unread-dot" role="img" aria-label="Directs ou replays mis à jour" hidden></span>
                            </button>
                        </nav>

                        <section id="chapters-panel" class="course-content-panel is-active" role="tabpanel" aria-labelledby="chapters-tab">
                            <h2 class="course-panel-heading">Les chapitres</h2>
                            <div class="modules-section" id="modules-container">
                                <!-- Modules and lessons will be loaded here -->
                            </div>
                        </section>

                        <section id="live-panel" class="course-content-panel" role="tabpanel" aria-labelledby="live-tab" hidden>
                            <div class="course-live-panel-card">
                                <div class="course-live-panel-heading">
                                    <div>
                                        <h3>Replays du cours</h3>
                                        <p>Retrouve les enregistrements des séances, classés par mois.</p>
                                    </div>
                                    <i class="fas fa-video" aria-hidden="true"></i>
                                </div>
                                <div id="course-live-list" class="course-live-months"></div>
                            </div>
                        </section>
                    </div>

                    <!-- Sidebar -->
                    <div class="course-sidebar">
                        <!-- Resources -->
                        <div class="sidebar-card">
                            <h4 class="sidebar-card-title"><i class="fas fa-folder-open" aria-hidden="true"></i> Ressources</h4>
                            <div id="course-resources-list">Chargement des formats…</div>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </div>

    <!-- Include API client + shared shell (mobile menu / notifications / logout) -->
    <script src="/js/authentication.js"></script>
    <script src="/js/user.js?v=20261124-notifications"></script>
    <script src="/js/api-client.js"></script>
    <script src="/js/course-image.js"></script>
    <script src="/js/learning-player.js?v=2"></script>
    <script src="/js/replay-player.js"></script>
    <script src="/js/course-markdown.js?v=2"></script>
    <script src="/js/course-details.js?v=9"></script>
</body>
</html>
