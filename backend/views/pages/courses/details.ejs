<!DOCTYPE html>
<html lang="fr" dir="ltr">
<head>
    <%- include('../../partials/head', { title: 'Détails du Cours', css: 'courses', 
        extraHead: '<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">' 
    }) %>
    <style>
        .course-details-container {
            max-width: 1400px;
            margin: 0 auto;
            width: 100%;
            padding: 1.5rem;
            background-color: #f8fafc;
            min-height: calc(100vh - 80px);
        }
        
        .back-link {
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            color: #64748b;
            text-decoration: none;
            font-weight: 600;
            margin-bottom: 1.5rem;
            transition: all 0.3s;
            font-size: 0.95rem;
        }
        
        .back-link:hover {
            color: var(--orange-primary);
        }
        
        .course-layout {
            display: grid;
            grid-template-columns: 1fr 340px;
            gap: 1.5rem;
            align-items: start;
        }
        
        /* ══ MAIN CONTENT ══ */
        .course-main {
            display: flex;
            flex-direction: column;
            gap: 1.5rem;
        }
        
        /* Hero Banner */
        .course-hero {
            background: white;
            border-radius: 24px;
            padding: 2rem;
            box-shadow: 0 4px 20px rgba(0,0,0,0.03);
            display: flex;
            align-items: center;
            gap: 2rem;
            position: relative;
            overflow: hidden;
            border: 1px solid #f1f5f9;
        }

        .hero-bg-accent {
            position: absolute;
            right: 0;
            top: 0;
            bottom: 0;
            width: 300px;
            background: linear-gradient(135deg, transparent, #fff7ed);
            pointer-events: none;
        }
        
        .course-thumbnail-hero {
            width: 120px;
            height: 120px;
            border-radius: 20px;
            box-shadow: 0 8px 25px rgba(249, 115, 22, 0.2);
            overflow: hidden;
            flex-shrink: 0;
        }
        
        .course-title-wrapper {
            flex: 1;
            z-index: 2;
        }
        
        .course-badge {
            background: #eff6ff;
            color: #3b82f6;
            padding: 0.3rem 0.8rem;
            border-radius: 20px;
            font-size: 0.75rem;
            font-weight: 700;
            display: inline-block;
            margin-bottom: 0.8rem;
        }
        
        .course-title-section h1 {
            font-size: 2rem;
            color: #1e293b;
            margin: 0 0 0.5rem;
            font-weight: 800;
            line-height: 1.2;
        }
        
        .course-subtitle {
            color: #64748b;
            font-size: 1rem;
            margin: 0 0 1rem;
        }
        
        .hero-stats {
            display: flex;
            gap: 1.5rem;
        }
        
        .hero-stat-item {
            display: flex;
            align-items: center;
            gap: 0.4rem;
            font-weight: 600;
            font-size: 0.9rem;
        }
        
        .hero-mascot {
            font-size: 5rem;
            z-index: 2;
            transform: translateY(10px);
        }

        /* Progress Card */
        .progress-card {
            background: white;
            border-radius: 24px;
            padding: 2rem;
            box-shadow: 0 4px 20px rgba(0,0,0,0.03);
            border: 1px solid #f1f5f9;
        }

        /* Modules Section */
        .modules-section {
            display: flex;
            flex-direction: column;
            gap: 1.2rem;
            margin-top: 1rem;
        }
        
        .module-card {
            background: white;
            border-radius: 20px;
            overflow: hidden;
            border: 1px solid #e2e8f0;
            box-shadow: 0 4px 15px rgba(0,0,0,0.02);
            transition: all 0.3s ease;
        }
        
        .module-header {
            padding: 1.5rem;
            background: #f8fafc;
            cursor: pointer;
            display: flex;
            justify-content: space-between;
            align-items: center;
            transition: all 0.3s ease;
            border-bottom: 1px solid transparent;
        }
        
        .module-header:hover {
            background: #f1f5f9;
        }

        .module-card.open .module-header {
            border-bottom: 1px solid #e2e8f0;
            background: white;
        }
        
        .module-header h3 {
            font-size: 1.15rem;
            color: #1e293b;
            font-weight: 700;
            margin: 0;
            display: flex;
            align-items: center;
            gap: 0.75rem;
        }

        .module-header h3::before {
            content: '📂';
            font-size: 1.2rem;
        }
        
        .module-toggle {
            font-size: 1rem;
            color: #64748b;
            transition: transform 0.3s;
            width: 32px;
            height: 32px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 50%;
            background: white;
            border: 1px solid #e2e8f0;
        }
        .module-card.open .module-toggle { transform: rotate(180deg); }
        
        .lessons-list {
            padding: 1.5rem;
            display: none;
            background: white;
            gap: 0.75rem;
            flex-direction: column;
        }
        .module-card.open .lessons-list { display: flex; }
        
        .lesson-item {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 1.2rem 1.5rem;
            background: #f8fafc;
            border-radius: 16px;
            border: 1px solid #f1f5f9;
            transition: all 0.2s;
        }
        
        .lesson-item:hover:not(.locked) {
            background: white;
            transform: translateX(4px);
            border-color: #fdba74;
            box-shadow: 0 4px 15px rgba(249, 115, 22, 0.08);
        }
        
        .lesson-info {
            display: flex;
            gap: 1.2rem;
            align-items: center;
        }
        
        .lesson-icon {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.1rem;
            box-shadow: 0 2px 8px rgba(0,0,0,0.05);
            flex-shrink: 0;
        }

        .lesson-icon.completed { background: #10b981; color: #ffffff; box-shadow: 0 4px 12px rgba(16, 185, 129, 0.2); }
        .lesson-icon.active { background: #f97316; color: #ffffff; box-shadow: 0 4px 12px rgba(249, 115, 22, 0.2); }
        .lesson-icon.locked { background: #e2e8f0; color: #94a3b8; box-shadow: none; }
        
        .lesson-title {
            font-size: 1rem;
            color: #334155;
            font-weight: 700;
        }
        
        .lesson-duration {
            font-size: 0.85rem;
            color: #64748b;
            display: flex;
            align-items: center;
            gap: 0.3rem;
            margin-top: 0.25rem;
        }
        
        /* ══ SIDEBAR ══ */
        .course-sidebar {
            display: flex;
            flex-direction: column;
            gap: 1.5rem;
        }
        
        .sidebar-card {
            background: white;
            border-radius: 24px;
            padding: 1.5rem;
            box-shadow: 0 4px 20px rgba(0,0,0,0.03);
            border: 1px solid #f1f5f9;
        }
        
        .course-thumbnail-sidebar {
            width: 100%;
            height: 160px;
            border-radius: 16px;
            overflow: hidden;
            margin-bottom: 1.5rem;
            background: #f1f5f9;
        }
        
        .course-stats-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 1rem;
            margin-bottom: 1.5rem;
        }
        
        .stat-box {
            text-align: center;
            padding: 1rem;
            background: #f8fafc;
            border-radius: 16px;
        }
        .stat-box strong { display: block; font-size: 1.2rem; color: #1e293b; font-weight: 800; margin-bottom: 0.2rem; }
        .stat-box span { font-size: 0.8rem; color: #64748b; font-weight: 600; }
        
        .buy-button {
            width: 100%;
            background: #f97316;
            color: white;
            border: none;
            border-radius: 16px;
            padding: 1.2rem;
            font-weight: 700;
            font-size: 1rem;
            cursor: pointer;
            transition: all 0.3s;
            box-shadow: 0 8px 20px rgba(249, 115, 22, 0.2);
        }
        
        .buy-button:hover {
            transform: translateY(-2px);
            box-shadow: 0 10px 25px rgba(249, 115, 22, 0.3);
        }

        .resource-item {
            display: flex;
            align-items: center;
            gap: 1rem;
            padding: 1rem;
            background: #f8fafc;
            border-radius: 12px;
            margin-bottom: 0.5rem;
            cursor: pointer;
            transition: all 0.2s;
        }
        .resource-item:hover { background: #f1f5f9; }
        
        @media (max-width: 1024px) {
            .course-layout { grid-template-columns: 1fr; }
            .course-hero { flex-direction: column; text-align: center; }
            .hero-stats { justify-content: center; }
            .hero-mascot { display: none; }
        }
    </style>
</head>
<body>
    <%- include('../../partials/header') %>

    <div class="content-wrapper">
        <%- include('../../partials/sidebar', { active: 'courses' }) %>

        <section id="main-section" class="main-section">
            <div class="course-details-container">
                <a href="/app/courses" class="back-link">← Retour aux cours</a>
                
                <div class="course-layout">
                    <!-- Main Content -->
                    <div class="course-main">
                        
                        <!-- Hero Banner -->
                        <div class="course-hero">
                            <div class="hero-bg-accent"></div>
                            <div class="course-thumbnail-hero" id="course-thumbnail-hero">
                                <!-- Thumbnail -->
                            </div>
                            <div class="course-title-wrapper">
                                <span class="course-badge" id="course-category-badge">Niveau Requis</span>
                                <h1 id="course-title">Chargement...</h1>
                                <p class="course-subtitle" id="course-description">Chargement de la description...</p>
                                <div class="hero-stats">
                                    <div class="hero-stat-item"><span style="color: #f97316;">🔥</span> 5 jours de suite</div>
                                    <div class="hero-stat-item"><span style="color: #eab308;">⭐</span> 125 XP</div>
                                </div>
                            </div>
                            <div class="hero-mascot">🐝</div>
                        </div>
                        
                        <!-- Progress Area -->
                        <div class="progress-card" id="progress-container">
                            <div style="display: flex; justify-content: space-between; margin-bottom: 1rem;">
                                <h3 style="margin: 0; font-size: 1.1rem; color: #1e293b;">Progression du cours</h3>
                                <span style="font-weight: 700; color: #1e293b;" id="progress-percentage-text">0%</span>
                            </div>
                            <div style="height: 8px; background: #f1f5f9; border-radius: 10px; overflow: hidden; margin-bottom: 1rem;">
                                <div id="progress-bar-fill" style="height: 100%; background: #10b981; width: 0%; border-radius: 10px;"></div>
                            </div>
                            <div style="display: flex; justify-content: space-between; align-items: center; font-size: 0.9rem;">
                                <div style="display: flex; align-items: center; gap: 0.5rem; color: #10b981; font-weight: 600;">
                                    <i class="fas fa-check-circle"></i> <span id="progress-completed-text">0 / 0 leçons</span>
                                </div>
                            </div>
                        </div>
                        
                        <h3 style="margin: 1rem 0 0; font-size: 1.2rem; color: #1e293b;">Les chapitres</h3>
                        
                        <div class="modules-section" id="modules-container">
                            <!-- Modules and lessons will be loaded here -->
                        </div>
                    </div>
                    
                    <!-- Sidebar -->
                    <div class="course-sidebar">
                        <div class="sidebar-card">
                            <div class="course-thumbnail-sidebar" id="course-thumbnail">
                                <!-- Thumbnail -->
                            </div>
                            
                            <div class="course-stats-grid">
                                <div class="stat-box">
                                    <strong id="lessons-count">0</strong>
                                    <span>Leçons</span>
                                </div>
                                <div class="stat-box">
                                    <strong id="quizzes-count">3</strong>
                                    <span>Quiz</span>
                                </div>
                                <div class="stat-box">
                                    <strong id="lives-count">2</strong>
                                    <span>Lives</span>
                                </div>
                                <div class="stat-box">
                                    <strong id="course-language">Français</strong>
                                    <span>Langue</span>
                                </div>
                            </div>
                            
                            <div style="display: flex; align-items: center; gap: 0.5rem; color: #64748b; font-size: 0.85rem; margin-bottom: 1.5rem; justify-content: center;">
                                <i class="far fa-clock"></i> Dernière activité: Aujourd'hui
                            </div>
                            
                            <button class="buy-button" id="buy-button">Découvrir les offres</button>
                        </div>
                        
                        <!-- Resources -->
                        <div class="sidebar-card">
                            <h4 style="margin: 0 0 1rem; color: #1e293b; font-size: 1rem;">📁 Ressources</h4>
                            <div class="resource-item">
                                <div style="color: #ef4444; font-size: 1.2rem;"><i class="fas fa-file-pdf"></i></div>
                                <div style="flex: 1; font-size: 0.9rem; font-weight: 600; color: #334155;">PDF Résumé</div>
                                <i class="fas fa-chevron-right" style="color: #cbd5e1; font-size: 0.8rem;"></i>
                            </div>
                            <div class="resource-item">
                                <div style="color: #3b82f6; font-size: 1.2rem;"><i class="fas fa-file-alt"></i></div>
                                <div style="flex: 1; font-size: 0.9rem; font-weight: 600; color: #334155;">Séries d'exercices</div>
                                <i class="fas fa-chevron-right" style="color: #cbd5e1; font-size: 0.8rem;"></i>
                            </div>
                            <div class="resource-item">
                                <div style="color: #10b981; font-size: 1.2rem;"><i class="fas fa-code"></i></div>
                                <div style="flex: 1; font-size: 0.9rem; font-weight: 600; color: #334155;">Fichiers Python</div>
                                <i class="fas fa-chevron-right" style="color: #cbd5e1; font-size: 0.8rem;"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </div>
    
    <!-- Include API client -->
    <script src="/js/authentication.js"></script>
    <script src="/js/api-client.js"></script>
    <script src="/js/course-details.js"></script>
</body>
</html>
