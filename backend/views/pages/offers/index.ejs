<!DOCTYPE html>
<html lang="fr" dir="ltr">
<head>
    <%- include('../../partials/head', { title: 'Plans d\'abonnement',
        extraHead: '<script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.9.2/dist/confetti.browser.min.js"><\/script>' }) %>
    <link rel="stylesheet" href="/css/offers.css?v=5" data-turbo-track="reload">
    <link rel="stylesheet" href="/css/offer-upgrade-checkout.css">
</head>
<body class="page-offers">
    <div id="global-hydration-overlay"><div class="spinner"></div></div>
    <%- include('../../partials/header') %>

    <div class="content-wrapper">
        <%- include('../../partials/sidebar', { active: 'offers' }) %>

        <section id="main-section" class="main-section">
            <div class="offers-container">
                <nav class="mobile-offer-nav" id="mobile-offer-nav" aria-label="Parcourir les offres" hidden>
                    <button id="nav-prev-btn" class="mob-nav-btn" aria-label="Offre précédente" disabled>
                        <span aria-hidden="true">‹</span>
                    </button>
                    <span class="offer-indicator" id="offer-indicator" aria-live="polite">1 / 1</span>
                    <button id="nav-next-btn" class="mob-nav-btn" aria-label="Offre suivante">
                        <span aria-hidden="true">›</span>
                    </button>
                </nav>
                <div class="offers-list" id="offers-list">
                    <div class="loading" role="status">Chargement des offres...</div>
                </div>
            </div>
        </section>
    </div>

    <!-- Scripts -->
    <script src="/js/authentication.js"></script>
    <script src="/js/user.js"></script>
    <script src="/js/api-client.js"></script>
    <script src="/js/offers-config.js"></script>
    <script src="/js/offer-upgrade-checkout.js?v=3"></script>
    <script src="/js/offers.js?v=15"></script>
</body>
</html>
